{% extends 'base.html.twig' %}

{% block stylesheets %}
<style>
    .legal-main { width: 100%; max-width: 48rem; margin-inline: auto; padding: 2rem 1rem 7rem; }
    .legal-back { color: #007a5e; font-size: .8rem; font-weight: 800; text-decoration: none; }
    .legal-card { margin-top: 1rem; border: 1px solid #d7e0da; border-radius: 1rem; background: #fff; padding: 1rem; }
    .legal-card h2 { color: #1a2b48; font-size: 1rem; font-weight: 900; }
    .legal-card p, .legal-card li { margin-top: .75rem; color: #475569; font-size: .78rem; line-height: 1.65; }
    .legal-card ul { padding-left: 1.25rem; list-style: disc; }
</style>
{% endblock %}

{% block body %}
<div class="fit-page fit-text min-h-screen font-sans">
    <main class="legal-main">
        <a class="legal-back" href="{{ app.request.headers.get('referer') ?: path('app_home') }}">← Retour</a>
        <p class="mt-8 text-[10px] font-extrabold uppercase tracking-[.2em] text-emerald-600">FitProgress</p>
        <h1 class="mt-3 text-3xl font-black leading-tight">{% block legal_heading %}{% endblock %}</h1>
        <p class="mt-2 text-xs text-slate-500">Dernière mise à jour : 13 août 2026</p>
        {% block legal_content %}{% endblock %}
        <p class="mt-8 text-center text-xs text-slate-500">Une question ? <a class="font-bold text-emerald-700" href="mailto:support@fitprogress.local">Contacter le support</a></p>
    </main>
</div>
{% endblock %}
