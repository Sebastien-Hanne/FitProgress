<header class="border-b border-slate-100 bg-white" aria-label="En-tête principal">
<div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3 sm:px-8 lg:px-10 lg:py-4">
    <a href="{{ path('app_home') }}" class="flex min-w-0 items-center gap-2.5" aria-label="FitProgress, accueil">
        <span class="flex size-9 items-center justify-center overflow-hidden rounded-xl bg-emerald-50">
            <img src="{{ asset('img/logo-small.png') }}" alt="" width="36" height="36" decoding="async" class="h-9 w-9 scale-[2.4] object-cover object-center">
        </span>
        <span class="truncate text-sm font-black tracking-tight text-[#1A2B48]">FitProgress</span>
    </a>

    <div class="flex items-center gap-2">
        {% if app.user %}
        <a href="{{ path('app_notifications') }}" class="relative flex size-9 items-center justify-center rounded-full bg-slate-50 text-[#1A2B48] transition hover:bg-slate-100" aria-label="Voir mes notifications">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 17H9m9-2V9a6 6 0 10-12 0v6l-2 2h16l-2-2zM10 21h4"/>
            </svg>
        </a>
        {% set profileRoute = is_granted('ROLE_COACH') and not is_granted('ROLE_ADMIN') ? 'app_coach_space_profile' : 'app_profile' %}
        <a href="{{ path(profileRoute) }}" class="flex size-9 items-center justify-center overflow-hidden rounded-full bg-[#1A2B48] text-xs font-bold text-white transition hover:bg-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2" aria-label="Voir le profil de {{ app.user.name }}">
            {% if app.user.photo %}<img src="{{ asset(app.user.photo) }}" alt="" class="size-full object-cover">{% else %}{{ app.user.name|first|upper }}{% endif %}
        </a>
        {% else %}
        <a href="{{ path('app_login') }}" class="rounded-xl bg-[#1A2B48] px-4 py-2 text-xs font-bold text-white transition hover:bg-emerald-700">Connexion</a>
        {% endif %}
    </div>
</div>
</header>
