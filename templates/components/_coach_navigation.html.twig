<nav class="fixed inset-x-0 bottom-0 z-30 mx-auto grid h-[4.25rem] w-full max-w-3xl grid-cols-4 border border-b-0 border-slate-200 bg-white px-2 pb-[max(.35rem,env(safe-area-inset-bottom))] pt-1.5 shadow-[0_-4px_16px_rgba(15,23,42,.06)]" aria-label="Navigation coach">
{% for item in items %}<a href="{{ path(item[3]) }}" class="relative flex min-h-11 flex-col items-center justify-center gap-0.5 rounded-full px-1 py-1 text-[0.6rem] font-bold transition {{ activeItem == item[0] ? 'bg-emerald-500 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-50' }}" {% if activeItem == item[0] %}aria-current="page"{% endif %}><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ item[2] }}"/></svg><span>{{ item[1] }}</span></a>{% endfor %}
</nav>
