    ['feedback', 'Feedback', 'M21 15a4 4 0 01-4 4H8l-5 3V7a4 4 0 014-4h10a4 4 0 014 4v8z', 'app_coach_space_feedback'],
    ['schedule', 'Planning', 'M7 3v3m10-3v3M4 9h16M5 5h14a2 2 0 012 2v13H3V7a2 2 0 012-2z', 'app_coach_space_schedule'],
