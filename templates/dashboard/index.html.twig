{% extends 'base.html.twig' %}

{% block title %}Mon dashboard | FitProgress{% endblock %}

{% block body %}
{% set selectedPeriod = app.request.query.get('period') == 'week' ? 'week' : 'month' %}
{% set displayedLabels = selectedPeriod == 'week' ? dashboard.weightHistory.labels|slice(-7) : dashboard.weightHistory.labels %}
{% set displayedWeights = selectedPeriod == 'week' ? dashboard.weightHistory.values|slice(-7) : dashboard.weightHistory.values %}
<div
    class="fit-page fit-text min-h-screen font-sans"
    data-controller="dashboard-actions"
    data-labels="{{ dashboard.weightHistory.labels|json_encode|e('html_attr') }}"
    data-weights="{{ dashboard.weightHistory.values|json_encode|e('html_attr') }}"
>
    <div class="fit-page min-h-screen w-full">
        {% include 'components/_app_header.html.twig' with {notificationInteractive: true} %}

        <main class="dashboard-grid mx-auto grid max-w-7xl gap-4 px-4 pb-24 pt-4 sm:px-6 lg:grid-cols-12 lg:gap-6 lg:px-10 lg:pb-32 lg:pt-10">
            <section class="dashboard-full hidden lg:col-span-12 lg:block lg:pb-2" aria-labelledby="dashboard-title">
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-600">Votre progression</p>
                <div class="mt-2 flex items-end justify-between gap-8">
                    <div>
                        <h1 id="dashboard-title" class="text-4xl font-black tracking-tight text-[#1A2B48]">Bonjour {{ app.user and app.user.name ? app.user.name : '' }}</h1>
                        <p class="mt-3 max-w-2xl text-base leading-7 text-slate-500">Retrouvez en un coup d’œil vos données du journal, votre évolution et les conseils de votre coach.</p>
                    </div>
                    <span class="rounded-full bg-emerald-50 px-4 py-2 text-xs font-bold text-emerald-700">Objectif en cours · {{ dashboard.goalProgress }}% du trajet</span>
                </div>
            </section>
            {% if dashboard.showWeightReminder %}<section class="dashboard-full fit-alert flex items-start gap-3 rounded-2xl border p-3 lg:col-span-12 lg:px-5 lg:py-4" style="background-color:#ffe3e1;border-color:#ffc9c5;color:#dc5d58" aria-label="Rappel de pesée" data-dashboard-actions-target="alert">
                <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 4.3L2.6 18a2 2 0 001.7 3h15.4a2 2 0 001.7-3L13.7 4.3a2 2 0 00-3.4 0z"/></svg>
                <div class="min-w-0 flex-1">
                    <h1 class="text-xs font-extrabold">Pensez à vous peser</h1>
                    <p class="mt-0.5 text-[10px] leading-4">{% if dashboard.daysSinceWeighIn is null %}Aucune pesée n’a encore été enregistrée.{% else %}Aucune pesée n’a été enregistrée depuis {{ dashboard.daysSinceWeighIn }} jour{{ dashboard.daysSinceWeighIn > 1 ? 's' : '' }}.{% endif %} La régularité, c’est la clé !</p>
                </div>
                <button type="button" class="flex size-8 shrink-0 items-center justify-center rounded-full text-lg leading-none text-rose-500 transition hover:bg-rose-100 hover:text-rose-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-400" aria-label="Fermer le rappel de pesée" data-action="dashboard-actions#dismissAlert">×</button>
            </section>{% endif %}

            <section class="dashboard-weight dashboard-stat-card flex flex-col items-center justify-center rounded-2xl border border-slate-200 bg-white p-4 text-center shadow-sm lg:col-span-5 lg:rounded-[2rem] lg:border-slate-100 lg:p-6 lg:shadow-[0_16px_45px_rgba(26,43,72,0.07)]" style="display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center" aria-labelledby="weight-title">
                <div class="flex flex-col items-center gap-3" style="display:flex;flex-direction:column;align-items:center">
                    <div>
                        <h2 id="weight-title" class="text-xs font-bold uppercase tracking-wider text-slate-500 lg:text-sm">Poids actuel</h2>
                        <p class="mt-2 text-4xl font-black text-slate-950 lg:text-5xl">{% if dashboard.currentWeight is not null %}{{ dashboard.currentWeight|number_format(1, ',', ' ') }} <span class="text-2xl font-extrabold lg:text-3xl">kg</span>{% else %}—{% endif %}</p>
                    </div>
                    <span class="rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-extrabold text-emerald-700 lg:text-sm">{{ dashboard.weightVariation > 0 ? '↗' : (dashboard.weightVariation < 0 ? '↘' : '→') }} {{ dashboard.weightVariation|abs|number_format(1, ',', ' ') }} kg</span>
                </div>
                <div class="mt-4 flex w-full max-w-md items-center justify-between text-xs text-slate-500 lg:text-sm">
                    <span>{% if dashboard.targetWeight is not null %}Tendance vers {{ dashboard.targetWeight|number_format(1, ',', ' ') }} kilos{% else %}Objectif non renseigné{% endif %}</span>
                    <strong class="text-sm text-emerald-700 lg:text-base">{{ dashboard.goalProgress }}% du trajet</strong>
                </div>
                <div class="mt-2 h-2.5 w-full max-w-md overflow-hidden rounded-full bg-slate-100" role="progressbar" aria-label="Progression vers l’objectif" aria-valuenow="{{ dashboard.goalProgress }}" aria-valuemin="0" aria-valuemax="100">
                    <div class="h-full rounded-full bg-emerald-600" style="width: {{ dashboard.goalProgress }}%"></div>
                </div>
            </section>

            <section class="dashboard-bmi dashboard-stat-card flex flex-col items-center justify-center rounded-2xl border border-slate-200 bg-white p-4 text-center shadow-sm lg:col-span-7 lg:rounded-[2rem] lg:border-slate-100 lg:p-6 lg:shadow-[0_16px_45px_rgba(26,43,72,0.07)]" style="display:flex;flex-direction:column;align-items:center;justify-content:center" aria-labelledby="bmi-title">
                <h2 id="bmi-title" class="sr-only" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">Indice de masse corporelle</h2>
                <div class="relative mx-auto h-28 w-28" style="position:relative;width:7rem;height:7rem;margin-left:auto;margin-right:auto">
                    <svg class="h-28 w-28 -rotate-90" viewBox="0 0 120 120" aria-hidden="true">
                        <circle cx="60" cy="60" r="46" fill="none" stroke="#e2e8f0" stroke-width="9"/>
                        <circle cx="60" cy="60" r="46" fill="none" stroke="{{ dashboard.bmiColor }}" stroke-width="9" stroke-linecap="round" stroke-dasharray="220 290"/>
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center" style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center">
                        <span class="text-xs font-bold uppercase text-slate-400">IMC</span>
                        <strong class="text-3xl font-black text-slate-950">{{ dashboard.bmi is not null ? dashboard.bmi|number_format(1, ',', ' ') : '—' }}</strong>
                    </div>
                </div>
                <span class="mt-1 inline-flex rounded-full px-3 py-1 text-[9px] font-extrabold text-white" style="background-color:{{ dashboard.bmiBadgeColor }}">{{ dashboard.bmiStatus }}</span>
            </section>

            <section
                class="dashboard-chart rounded-2xl border border-slate-200 bg-white p-4 shadow-sm lg:col-span-8 lg:rounded-[2rem] lg:p-6"
                aria-labelledby="chart-title"
                data-controller="dashboard-chart"
                data-dashboard-chart-labels-value="{{ displayedLabels|json_encode|e('html_attr') }}"
                data-dashboard-chart-weights-value="{{ displayedWeights|json_encode|e('html_attr') }}"
            >
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h2 id="chart-title" class="text-base font-black leading-tight">Suivi du<br>poids</h2>
                        <p class="mt-1 text-[9px] text-slate-400" data-dashboard-chart-target="subtitle">{{ selectedPeriod == 'week' ? '7 derniers jours' : '30 derniers jours' }}</p>
                    </div>
                    <form method="get" action="{{ path('dashboard') }}" class="flex rounded-full bg-slate-100 p-1 text-[9px] font-bold" aria-label="Période affichée">
                        <button type="submit" name="period" value="month" class="{{ selectedPeriod == 'month' ? 'fit-period-active' : '' }} rounded-full px-3 py-1 text-[#58708f] transition hover:bg-white" aria-pressed="{{ selectedPeriod == 'month' ? 'true' : 'false' }}">Mois</button>
                        <button type="submit" name="period" value="week" class="{{ selectedPeriod == 'week' ? 'fit-period-active' : '' }} rounded-full px-3 py-1 text-[#58708f] transition hover:bg-white" aria-pressed="{{ selectedPeriod == 'week' ? 'true' : 'false' }}">Semaine</button>
                    </form>
                </div>
                <div class="mt-4 h-44 lg:h-72">
                    {% if displayedWeights is not empty %}<canvas
                        data-dashboard-chart-target="canvas"
                        aria-label="Évolution du poids au cours des 30 derniers jours"
                        role="img"
                    ></canvas>{% else %}<div class="flex h-full items-center justify-center text-center text-xs text-slate-500">Ajoutez une pesée dans votre journal pour afficher votre évolution.</div>{% endif %}
                </div>
            </section>

            <section class="dashboard-actions grid gap-2 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm lg:col-span-4 lg:gap-3 lg:rounded-[2rem] lg:border-slate-100 lg:p-6 lg:shadow-[0_16px_45px_rgba(26,43,72,0.06)]" aria-label="Actions rapides">
                {% set actions = [
                    ['Chat', 'Chat', dashboard.coachName ? 'Votre messagerie avec ' ~ dashboard.coachName ~ ' est disponible.' : 'Aucun coach n’est encore associé à votre profil.', 'chat']
                ] %}
                <button type="button" class="fit-action-button flex w-full items-center justify-center rounded-xl px-4 py-3 text-[10px] font-extrabold uppercase tracking-wide transition" style="background-color:#1769aa;color:#ffffff" data-action="dashboard-actions#exportCsv">
                    Export CSV
                </button>
                <a href="{{ path('app_coach_index') }}" class="fit-action-button flex w-full items-center justify-center rounded-xl px-4 py-3 text-[10px] font-extrabold uppercase tracking-wide transition" style="background-color:#1769aa;color:#ffffff">
                    Choisir un coach
                </a>
                {% for action in actions %}
                    <button type="button" class="fit-action-button flex w-full items-center justify-center rounded-xl px-4 py-3 text-[10px] font-extrabold uppercase tracking-wide transition" style="background-color:#1769aa;color:#ffffff" data-action="dashboard-actions#open" data-action-name="{{ action[3] }}" data-title="{{ action[1] }}" data-content="{{ action[2] }}">
                        {{ action[0] }}
                    </button>
                {% endfor %}
                <a href="{{ path('app_notifications') }}" class="fit-action-button flex w-full items-center justify-center rounded-xl px-4 py-3 text-[10px] font-extrabold uppercase tracking-wide transition" style="background-color:#1769aa;color:#ffffff">Notifications</a>
                <a href="{{ path('app_user_sessions') }}" class="fit-action-button flex w-full items-center justify-center rounded-xl px-4 py-3 text-[10px] font-extrabold uppercase tracking-wide transition" style="background-color:#1769aa;color:#ffffff">Mes séances</a>
                <a href="{{ path('app_feedback') }}" class="fit-action-button flex w-full items-center justify-center rounded-xl px-4 py-3 text-[10px] font-extrabold uppercase tracking-wide transition" style="background-color:#1769aa;color:#ffffff">Feedback</a>
            </section>

            {% if dashboard.coachFeedback %}<section class="dashboard-full fit-feedback-card rounded-2xl p-5 text-white shadow-lg lg:col-span-12 lg:rounded-[2rem] lg:p-8" style="background-color:#494be8;color:#ffffff" aria-labelledby="feedback-title">
                <p class="text-[9px] font-bold uppercase tracking-[0.18em] text-white">Feedback du coach</p>
                <blockquote id="feedback-title" class="mt-3 max-w-4xl text-xs italic leading-5 text-white lg:text-sm lg:leading-6">« {{ dashboard.coachFeedback }} »</blockquote>
                <div class="mt-4 flex items-center gap-2">
                    <span class="flex size-8 items-center justify-center rounded-full bg-amber-300 text-[10px] font-black text-indigo-950">{{ dashboard.coachName ? dashboard.coachName|split(' ')|map(part => part|first|upper)|join|slice(0, 2) : 'C' }}</span>
                    <span class="text-[10px] font-bold">{{ dashboard.coachName ?? 'Votre coach' }}</span>
                </div>
            </section>{% endif %}
        </main>

        {% include 'components/_app_navigation.html.twig' with {active: 'dashboard'} %}

        <dialog class="w-[calc(100%-2rem)] max-w-md rounded-2xl border-0 p-0 text-[#1A2B48] shadow-2xl backdrop:bg-slate-900/50" data-dashboard-actions-target="dialog" data-action="click->dashboard-actions#closeOnBackdrop">
            <div class="p-6">
                <div class="flex items-start justify-between gap-4">
                    <h2 class="text-lg font-black" data-dashboard-actions-target="dialogTitle"></h2>
                    <button type="button" class="flex size-8 items-center justify-center rounded-full bg-slate-100 text-xl leading-none transition hover:bg-slate-200" aria-label="Fermer" data-action="dashboard-actions#close">×</button>
                </div>
                <p class="mt-4 text-sm leading-6 text-slate-600" data-dashboard-actions-target="dialogContent"></p>
                <button type="button" class="mt-6 w-full rounded-xl bg-emerald-500 px-4 py-3 text-xs font-extrabold uppercase text-white transition hover:bg-emerald-600" data-action="dashboard-actions#close">Compris</button>
            </div>
        </dialog>
    </div>
</div>
{% endblock %}
