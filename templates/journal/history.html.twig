{% extends 'base.html.twig' %}

{% block title %}Historique du journal | FitProgress{% endblock %}

{% block body %}
<div class="fit-page min-h-screen font-sans text-[#1A2B48]" style="background-color:#f7f9fc">
  <div class="journal-shell pb-24">
    {% include 'components/_app_header.html.twig' %}

    <main class="journal-main mx-auto w-full max-w-7xl px-4 py-5 sm:px-6 lg:px-10 lg:py-10">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-emerald-600">Votre progression</p>
                <h1 class="mt-1 text-2xl font-black lg:text-3xl">Historique du journal</h1>
            </div>
            <div class="flex gap-2">
                <a href="{{ path('app_journal_today') }}" class="flex-1 rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-center text-[10px] font-extrabold uppercase text-slate-600 sm:flex-none">Journal du jour</a>
                <a href="{{ path('app_journal_export') }}" class="flex-1 rounded-xl bg-[#1769aa] px-3 py-2.5 text-center text-[10px] font-extrabold uppercase text-white sm:flex-none">Exporter CSV</a>
            </div>
        </div>

        {% for message in app.flashes('success') %}<div class="mt-4 rounded-2xl bg-emerald-50 p-4 text-xs font-semibold text-emerald-800">{{ message }}</div>{% endfor %}
        {% for message in app.flashes('error') %}<div class="mt-4 rounded-2xl bg-rose-50 p-4 text-xs font-semibold text-rose-800" role="alert">{{ message }}</div>{% endfor %}

        <nav class="mt-5 grid grid-cols-4 rounded-2xl bg-slate-100 p-1 text-center text-[10px] font-bold" aria-label="Filtrer l’historique">
            {% set periods = {'7': '7 jours', '30': '30 jours', '90': '3 mois', 'all': 'Tout'} %}
            {% for value, label in periods %}
                <a href="{{ path('app_journal_history', {period: value}) }}" class="rounded-xl px-2 py-2.5 {{ period == value ? 'bg-emerald-500 text-white shadow-sm' : 'text-slate-500' }}">{{ label }}</a>
            {% endfor %}
        </nav>

        <div class="journal-history-grid mt-5 grid gap-4">
            {% for entry in entries %}
                {% include 'journal/_entry_card.html.twig' with {entry: entry, today: today} %}
            {% else %}
                <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
                    <p class="text-sm font-bold">Aucune entrée pour cette période.</p>
                    <a href="{{ path('app_journal_today') }}" class="mt-3 inline-flex rounded-xl bg-emerald-500 px-4 py-3 text-xs font-bold text-white">Remplir le journal</a>
                </div>
            {% endfor %}
        </div>

        {% if entries.pageCount > 1 %}
            <div class="mt-6 flex justify-center">{{ knp_pagination_render(entries, '@KnpPaginator/Pagination/tailwindcss_pagination.html.twig') }}</div>
        {% endif %}
    </main>

    {% include 'components/_app_navigation.html.twig' with {active: 'history', compact: true} %}
  </div>
</div>
{% endblock %}
