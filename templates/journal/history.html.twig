{% extends 'base.html.twig' %}
{% block title %}Historique d’activité | FitProgress{% endblock %}
{% block body %}
{% set periodLabels = {'7': '7 derniers jours', '30': '30 derniers jours', '90': '3 derniers mois', 'all': 'Depuis le début'} %}
{% set shortDays = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'] %}
{% set moodIcons = {'very_bad': '☹', 'bad': '☹', 'stable': '😐', 'good': '☺', 'excellent': '☺'} %}
{% set moodColors = {'very_bad': '#dc2626', 'bad': '#f97316', 'stable': '#ca8a04', 'good': '#10b981', 'excellent': '#059669'} %}
{% set metricLabel = metric == 'bmi' ? 'IMC' : 'Poids' %}
{% set metricUnit = metric == 'bmi' ? '' : 'kg' %}
<div class="fit-page min-h-screen font-sans text-[#1A2B48]" style="background-color:#f7f9fc">
    {% include 'components/_app_header.html.twig' %}
    <main class="mx-auto w-full max-w-5xl px-4 pb-28 pt-6 sm:px-6 lg:pt-10">
        <header><h1 class="text-2xl font-black tracking-tight lg:text-4xl">Historique d’Activité</h1><p class="mt-1 text-xs leading-5 text-slate-500 lg:text-sm">Analysez votre trajectoire de remise en forme à long terme</p></header>
        {% for message in app.flashes('success') %}<div class="mt-4 rounded-xl bg-emerald-50 p-4 text-xs font-semibold text-emerald-800">{{ message }}</div>{% endfor %}
        {% for message in app.flashes('error') %}<div class="mt-4 rounded-xl bg-rose-50 p-4 text-xs font-semibold text-rose-800" role="alert">{{ message }}</div>{% endfor %}

        <nav class="mt-7 flex gap-2 overflow-x-auto pb-1 text-[11px] font-bold" aria-label="Filtrer l’historique">
            {% for value, label in {'7': 'Semaine', '30': 'Mois', '90': '3 Mois', 'all': 'Tout'} %}<a href="{{ path('app_journal_history', {period: value, metric: metric}) }}" class="shrink-0 rounded-full px-4 py-2.5 {{ period == value ? 'bg-emerald-600 text-white shadow-sm' : 'bg-[#e8efff] text-slate-500' }}" {% if period == value %}aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
        </nav>
        <nav class="mt-3 flex gap-2 text-[10px] font-bold text-slate-500" aria-label="Type de mesure"><a href="{{ path('app_journal_history', {period: period, metric: 'weight'}) }}" class="px-5 py-2 {{ metric == 'weight' ? 'border-b-2 border-emerald-600 text-emerald-700' : '' }}">Poids</a><a href="{{ path('app_journal_history', {period: period, metric: 'bmi'}) }}" class="px-5 py-2 {{ metric == 'bmi' ? 'border-b-2 border-emerald-600 text-emerald-700' : '' }}">IMC</a></nav>

        <section class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Statistiques de poids">
            {% set cards = [
                [metricLabel ~ ' Min', stats.min, 'Minimum historique', 'text-emerald-600'],
                [metricLabel ~ ' Max', stats.max, 'Maximum historique', 'text-rose-500'],
                ['Moyenne', stats.average, periodLabels[period], 'text-indigo-500'],
                ['Variation Totale', stats.variation is null ? null : stats.variation|abs, stats.variation is not null and stats.variation <= 0 ? 'Progrès constants' : 'Évolution sur la période', stats.variation is not null and stats.variation <= 0 ? 'text-emerald-600' : 'text-amber-600']
            ] %}
            {% for card in cards %}<article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="text-xs font-medium text-slate-500">{{ card[0] }}</h2><p class="mt-3 text-3xl font-black">{{ card[1] is not null ? card[1]|number_format(1, ',', ' ') : '—' }}{% if card[1] is not null and metricUnit %} <small class="text-xs font-bold text-slate-500">{{ metricUnit }}</small>{% endif %}</p><p class="mt-2 flex items-center gap-1 text-[10px] {{ card[3] }}">{% if loop.index == 1 %}<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 7 5 5 4-4 5 5M19 8v5h-5"/></svg>{% elseif loop.index == 2 %}<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 17 5-5 4 4 5-5M14 11h5v5"/></svg>{% elseif loop.index == 3 %}<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-label="Période sélectionnée"><path stroke-linecap="round" stroke-linejoin="round" d="M6 3v3m12-3v3M4 9h16M5 5h14a2 2 0 0 1 2 2v13H3V7a2 2 0 0 1 2-2Z"/></svg>{% else %}<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 14h4l2-5 4 9 2-4h4"/></svg>{% endif %}<span>{{ card[2] }}</span></p></article>{% endfor %}
        </section>

        <section class="mt-5 rounded-xl border border-slate-200 bg-white p-5 shadow-sm" aria-labelledby="trend-title">
            <div class="flex items-center justify-between gap-4"><h2 id="trend-title" class="text-sm font-black">Analyse de Tendance</h2><span class="rounded-full bg-slate-100 px-3 py-1 text-[9px] font-bold text-slate-600">{{ periodLabels[period] }}</span></div>
            {% if chartEntries is not empty %}<div class="mt-7 flex h-56 items-end justify-around gap-2 border-b border-slate-100 px-2" style="padding-bottom:1rem" role="img" aria-label="Graphique de l’évolution du poids">
                {% for entry in chartEntries %}{% set value = metric == 'bmi' ? entry.bmi : entry.weight %}{% set height = 25 + (((value - chartMin) / chartRange) * 65) %}<div class="flex h-full min-w-0 flex-1 flex-col items-center justify-end"><span class="mb-2 text-[9px] font-bold text-slate-500">{{ value|number_format(1, ',', ' ') }}</span><div class="w-1.5 rounded-t-full {{ loop.last ? 'bg-emerald-600' : 'bg-emerald-200' }}" style="height:{{ height }}%"></div><span class="mt-3 text-[9px] font-bold">{{ shortDays[entry.date|date('w')] }}</span></div>{% endfor %}
            </div>{% else %}<div class="flex h-48 items-center justify-center text-center text-xs text-slate-500">Ajoutez une pesée dans votre journal pour afficher la tendance.</div>{% endif %}
        </section>

        <section class="mt-5 rounded-xl border border-slate-200 bg-white p-4 shadow-sm" aria-labelledby="recent-title">
            <h2 id="recent-title" class="mb-3 text-xs font-medium text-slate-500">Journaux Récents</h2><div class="overflow-x-auto"><table class="w-full min-w-[28rem] text-left text-[10px]"><thead class="bg-slate-50 text-[9px] font-bold uppercase tracking-wider text-slate-500"><tr><th class="px-3 py-3">Date</th><th class="px-3 py-3">{{ metricLabel }}</th><th class="px-3 py-3 text-center">Humeur</th></tr></thead><tbody class="divide-y divide-slate-100">
            {% for entry in recentEntries %}{% set mood = entry.mood ? entry.mood.value : null %}{% set recentValue = metric == 'bmi' ? entry.bmi : entry.weight %}<tr class="transition hover:bg-emerald-50"><td class="px-3 py-3 font-bold"><a href="{{ path('app_journal_show',{id:entry.id}) }}" class="block">{{ entry.date|date('d/m') }}<small class="block font-normal text-slate-400">{{ entry.date|date('Y') }}</small></a></td><td class="px-3 py-3"><a href="{{ path('app_journal_show',{id:entry.id}) }}" class="block">{{ recentValue is not null ? recentValue|number_format(1, ',', ' ') ~ (metricUnit ? ' ' ~ metricUnit : '') : '—' }}</a></td><td class="px-3 py-3 text-center text-base" style="color:{{ moodColors[mood]|default('#94a3b8') }}"><a href="{{ path('app_journal_show',{id:entry.id}) }}" class="block">{{ moodIcons[mood]|default('—') }}</a></td></tr>{% else %}<tr><td colspan="3" class="p-6 text-center text-slate-500">Aucun journal pour cette période.</td></tr>{% endfor %}
            </tbody></table></div>
        </section>

        <section id="complete-history" class="mt-5 scroll-mt-6 rounded-xl border border-slate-200 bg-white p-4 shadow-sm" aria-labelledby="complete-title">
            <h2 id="complete-title" class="mb-3 text-xs font-medium text-slate-500">Journal de Progrès Complet</h2><div class="overflow-x-auto"><table class="w-full min-w-[34rem] text-left text-[10px]"><thead class="bg-slate-50 text-[9px] font-bold text-slate-500"><tr><th class="px-3 py-3">Horodatage</th><th class="px-3 py-3">Poids (kg)</th><th class="px-3 py-3">IMC</th><th class="px-3 py-3 text-right">Action</th></tr></thead><tbody class="divide-y divide-slate-100">
            {% for entry in entries %}<tr><td class="px-3 py-3">{{ entry.date|date('d/m/Y') }}</td><td class="px-3 py-3 font-bold text-emerald-700">{{ entry.weight ? entry.weight|number_format(1, ',', ' ') : '—' }}</td><td class="px-3 py-3">{{ entry.bmi ? entry.bmi|number_format(1, ',', ' ') : '—' }}</td><td class="px-3 py-3 text-right">{% if entry.date|date('Y-m-d') == today|date('Y-m-d') %}<a href="{{ path('app_journal_edit', {id: entry.id}) }}" class="font-bold text-indigo-600">Modifier</a>{% else %}<span class="text-slate-300">—</span>{% endif %}</td></tr>{% else %}<tr><td colspan="4" class="p-6 text-center text-slate-500">Aucune donnée disponible.</td></tr>{% endfor %}
            </tbody></table></div>
            {% if entries.pageCount > 1 %}<div class="mt-4 flex justify-center">{{ knp_pagination_render(entries, '@KnpPaginator/Pagination/tailwindcss_pagination.html.twig') }}</div>{% endif %}{% if period != 'all' %}<a href="{{ path('app_journal_history', {period: 'all', metric: metric}) }}#complete-history" class="mt-4 flex justify-center text-[10px] font-bold text-emerald-700">Voir tout l’historique →</a>{% else %}<p class="mt-4 text-center text-[10px] font-bold text-emerald-700">Tout l’historique est affiché</p>{% endif %}
        </section>
        <div class="mt-5 grid grid-cols-2 gap-3"><a href="{{ path('app_journal_today') }}" class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-xs font-bold">Journal du jour</a><a href="{{ path('app_journal_export') }}" class="rounded-xl bg-[#1769aa] px-4 py-3 text-center text-xs font-bold text-white">Exporter CSV</a></div>
    </main>
    {% include 'components/_app_navigation.html.twig' with {active: 'history', compact: true} %}
</div>
{% endblock %}
