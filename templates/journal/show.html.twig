{% extends 'base.html.twig' %}
{% block title %}Journal du {{ entry.date|date('d/m/Y') }} | FitProgress{% endblock %}
{% block body %}
<div class="fit-page min-h-screen font-sans text-[#1A2B48]">{% include 'components/_app_header.html.twig' %}<main class="mx-auto max-w-5xl px-4 pb-28 pt-6 sm:px-6 lg:pt-10">
<a href="{{ coachView ? path('app_coach_space_client_show',{id:client.id}) : path('app_journal_history') }}" class="text-sm font-bold text-slate-600">← {{ coachView ? 'Retour à la fiche de ' ~ client.name : 'Retour à l’historique' }}</a>
<header class="mt-6 text-center"><p class="text-xs font-extrabold uppercase tracking-[.18em] text-emerald-600">{{ coachView ? 'Journal du client' : 'Votre progression au quotidien' }}</p><h1 class="mt-2 text-3xl font-black">Journal du {{ entry.date|date('d/m/Y') }}</h1><p class="mt-2 text-sm text-slate-500">Vue complète en lecture seule</p></header>

<section class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Résumé de la journée">{% set metrics = [['⚖','Poids',entry.weight ? entry.weight|number_format(1,',',' ') ~ ' kg' : '—'],['◇','IMC',entry.bmi ? entry.bmi|number_format(1,',',' ') : '—'],['◉','Humeur',entry.mood ? entry.mood.label : 'Non renseignée'],['↗','Énergie',entry.energyLevel ? entry.energyLevel.label : 'Non renseignée']] %}{% for metric in metrics %}<article class="rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm"><span class="text-xl text-emerald-600">{{ metric[0] }}</span><h2 class="mt-2 text-[10px] font-bold uppercase text-slate-400">{{ metric[1] }}</h2><strong class="mt-2 block text-lg">{{ metric[2] }}</strong></article>{% endfor %}</section>

<div class="mt-5 grid gap-5 lg:grid-cols-2"><section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="text-lg font-black">Bien-être &amp; activité</h2><dl class="mt-4 grid grid-cols-2 gap-3 text-sm"><div class="rounded-xl bg-slate-50 p-4"><dt class="text-xs text-slate-500">Sommeil</dt><dd class="mt-1 font-black">{{ entry.sleepHours ? entry.sleepHours|number_format(1,',',' ') ~ ' h' : '—' }}</dd></div><div class="rounded-xl bg-slate-50 p-4"><dt class="text-xs text-slate-500">Qualité du sommeil</dt><dd class="mt-1 font-black">{{ entry.sleepQuality ? entry.sleepQuality ~ '/5' : '—' }}</dd></div><div class="rounded-xl bg-slate-50 p-4"><dt class="text-xs text-slate-500">Hydratation</dt><dd class="mt-1 font-black">{{ entry.waterIntakeMl ? entry.waterIntakeMl ~ ' ml' : '—' }}</dd></div><div class="rounded-xl bg-slate-50 p-4"><dt class="text-xs text-slate-500">Pas</dt><dd class="mt-1 font-black">{{ entry.steps ? entry.steps|number_format(0,',',' ') : '—' }}</dd></div><div class="col-span-2 rounded-xl bg-slate-50 p-4"><dt class="text-xs text-slate-500">Activité physique</dt><dd class="mt-1 font-black">{{ entry.activityMinutes is not null ? entry.activityMinutes ~ ' minutes' : '—' }}</dd></div></dl></section>
<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex justify-between"><h2 class="text-lg font-black">Nutrition</h2><strong class="text-sm text-emerald-700">{{ entry.totalCalories }} kcal</strong></div><div class="mt-4 grid gap-3">{% for meal in entry.meals %}<article class="flex items-center justify-between rounded-xl bg-slate-50 p-4"><div><span class="text-[10px] font-bold uppercase text-emerald-700">{{ meal.type.label }}</span><h3 class="mt-1 text-sm font-bold">{{ meal.title }}</h3></div><span class="text-xs text-slate-500">{{ meal.calories ?? 0 }} kcal</span></article>{% else %}<p class="rounded-xl bg-slate-50 p-6 text-center text-sm text-slate-500">Aucun repas enregistré.</p>{% endfor %}</div></section></div>

<section class="mt-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="text-lg font-black">Notes de la journée</h2><p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-600">{{ entry.notes ?: 'Aucune note enregistrée.' }}</p>{% if entry.coachComment %}<div class="mt-5 rounded-xl bg-indigo-50 p-4"><h3 class="text-xs font-black text-indigo-700">Commentaire du coach</h3><p class="mt-2 text-sm text-indigo-950">{{ entry.coachComment }}</p></div>{% endif %}</section>
</main>{% if coachView %}{% include 'components/_coach_navigation.html.twig' with {active:'clients'} %}{% else %}{% include 'components/_app_navigation.html.twig' with {active:'history'} %}{% endif %}</div>
{% endblock %}
