{% extends 'base.html.twig' %}
{% block title %}Changer le mot de passe | FitProgress{% endblock %}
{% block body %}
<div class="fit-page fit-text min-h-screen font-sans">
    {% include 'components/_app_header.html.twig' %}
    <main class="mx-auto max-w-2xl px-4 pb-28 pt-8">
        <a href="{{ path('app_profile_account') }}" class="text-sm font-black text-emerald-700">← Retour aux paramètres</a>
        <h1 class="mt-8 text-3xl font-black">Changer le mot de passe</h1>
        <p class="mt-3 text-sm leading-6 text-slate-500">Confirmez votre mot de passe actuel, puis choisissez un mot de passe unique d’au moins 12 caractères.</p>
        <section class="account-card mt-6 rounded-2xl border border-slate-200 bg-white p-5">
            {{ form_start(passwordForm) }}
                {% for field in [passwordForm.currentPassword, passwordForm.plainPassword.first, passwordForm.plainPassword.second] %}
                    <div class="mb-4"><div class="mb-2 text-xs font-bold">{{ form_label(field) }}</div>{{ form_widget(field, {attr: {class: 'w-full rounded-xl border border-slate-300 p-3 text-sm'}}) }}<div class="mt-1 text-xs text-red-600">{{ form_errors(field) }}</div></div>
                {% endfor %}
                <button type="submit" class="w-full rounded-xl bg-emerald-500 p-3 text-sm font-black text-white">Modifier le mot de passe</button>
            {{ form_end(passwordForm) }}
        </section>
    </main>
</div>
{% endblock %}
