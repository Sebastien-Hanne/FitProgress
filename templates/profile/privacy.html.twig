{% extends 'base.html.twig' %}

{% block title %}Confidentialité | FitProgress{% endblock %}

{% block stylesheets %}
<style>
    .privacy-main { width: 100%; max-width: 48rem; margin-inline: auto; padding-bottom: 9rem !important; }
    .privacy-card { border: 1px solid #d7e0da; border-radius: 1rem; background: #fff; box-shadow: 0 2px 5px rgba(15,23,42,.05); }
    .privacy-switch { position: relative; width: 2.75rem; height: 1.5rem; border-radius: 999px; background: #cbd5e1; transition: .2s; }
    .privacy-switch::after { content: ''; position: absolute; top: .2rem; left: .2rem; width: 1.1rem; height: 1.1rem; border-radius: 50%; background: #fff; transition: .2s; }
    input:checked + .privacy-switch { background: #00b887; }
    input:checked + .privacy-switch::after { transform: translateX(1.25rem); }
    .privacy-data-row { display: flex; width: 100%; align-items: center; gap: .75rem; padding: 1rem; text-align: left; font-size: .75rem; text-decoration: none; }
    .privacy-data-row + .privacy-data-row { border-top: 1px solid #e2e8f0; }
    .privacy-data-row.is-danger { color: #dc2626 !important; }
    .privacy-protection-icon { display: flex; width: 4rem; height: 4rem; margin-inline: auto; align-items: center; justify-content: center; border-radius: 999px; background: #dff7ef; color: #008567; font-size: 1.5rem; }
    .delete-confirmation { margin-top: 1rem; border: 1px solid #fecaca; border-radius: 1rem; background: #fff; padding: 1rem; }
    .delete-confirmation input { width: 100%; margin-top: .75rem; border: 1px solid #cbd5e1; border-radius: .75rem; padding: .8rem; }
    .delete-confirmation button { width: 100%; margin-top: .75rem; border: 0; border-radius: .75rem; background: #dc2626; padding: .8rem; color: #fff; font-weight: 800; }
    .privacy-back { display: inline-flex; align-items: center; gap: .75rem; margin-top: 1.5rem; margin-bottom: 2rem; color: #007a5e; font-size: 1.15rem; font-weight: 900; text-decoration: none; }
    .privacy-back:hover { color: #005f49; }
    .privacy-introduction { margin-bottom: 2.5rem; }
    .privacy-section + .privacy-section { margin-top: 2rem !important; }
    .privacy-protection { margin-top: 3.5rem !important; }
    @media (min-width: 1024px) { .privacy-main { padding-top: 3rem !important; padding-bottom: 9rem !important; } }
</style>
{% endblock %}

{% block body %}
<div class="fit-page fit-text min-h-screen font-sans">
    {% include 'components/_app_header.html.twig' %}
    <main class="privacy-main px-4 pb-28 pt-7">
        <a href="{{ path(is_granted('ROLE_COACH') and not is_granted('ROLE_ADMIN') ? 'app_coach_space_profile' : 'app_profile') }}" class="privacy-back" aria-label="Retour au profil"><span aria-hidden="true">←</span><span>Retour au profil</span></a>
        <div class="privacy-introduction">
            <p class="text-[10px] font-extrabold uppercase tracking-[.2em] text-emerald-600">Confidentialité</p>
            <h1 class="mt-3 text-3xl font-black leading-tight">Vos données,<br>votre contrôle</h1>
            <p class="mt-3 text-sm leading-6 text-slate-500">Nous croyons en une transparence totale. Gérez la façon dont vos données de santé et de fitness sont partagées, stockées et protégées au sein de l’écosystème FitProgress.</p>
        </div>

        {% for message in app.flashes('success') %}<p class="mt-5 rounded-xl bg-emerald-50 p-3 text-xs font-bold text-emerald-700">{{ message }}</p>{% endfor %}
        {% for message in app.flashes('delete_error') %}<p class="mt-5 rounded-xl bg-red-50 p-3 text-xs font-bold text-red-700">{{ message }}</p>{% endfor %}

        {% if not (is_granted('ROLE_COACH') and not is_granted('ROLE_ADMIN')) %}
            <section class="privacy-section" aria-labelledby="visibility-title">
                <h2 id="visibility-title" class="mb-3 text-[10px] font-extrabold uppercase tracking-wider">◉ Visibilité du compte</h2>
                <form method="post" class="privacy-card flex items-center gap-4 p-4">
                    <div class="flex-1"><strong class="block text-xs">Partager avec les coachs</strong><p class="mt-1 text-[10px] leading-4 text-slate-500">Permet à votre entraîneur de consulter votre journal et vos graphiques de progression.</p></div>
                    <label class="cursor-pointer"><span class="sr-only">Partager mon profil avec les coachs</span><input type="checkbox" name="is_profile_visible" value="1" class="sr-only" onchange="this.form.submit()" {{ app.user.profileVisible ? 'checked' : '' }}><span class="privacy-switch block"></span></label>
                    <input type="hidden" name="_token" value="{{ csrf_token('profile-visibility') }}">
                </form>
            </section>
        {% endif %}

        <section class="privacy-section" aria-labelledby="data-title">
            <h2 id="data-title" class="mb-3 text-[10px] font-extrabold uppercase tracking-wider">▤ Gestion des données</h2>
            <div class="privacy-card overflow-hidden">
                {% if not (is_granted('ROLE_COACH') and not is_granted('ROLE_ADMIN')) %}
                    <a href="{{ path('app_journal_export') }}" class="privacy-data-row hover:bg-slate-50"><span>⇩</span><span class="flex-1">Exporter mon journal (CSV)</span><span class="text-slate-300">›</span></a>
                {% endif %}
                <a href="{{ path('app_legal_privacy') }}" class="privacy-data-row hover:bg-slate-50"><span>ⓘ</span><span class="flex-1">Politique de confidentialité</span><span class="text-slate-300">›</span></a>
                <a href="{{ path('app_legal_terms') }}" class="privacy-data-row hover:bg-slate-50"><span>§</span><span class="flex-1">Conditions d’utilisation</span><span class="text-slate-300">›</span></a>
                <button type="button" class="privacy-data-row is-danger" onclick="document.getElementById('delete-account-confirmation').hidden = !document.getElementById('delete-account-confirmation').hidden"><span>☒</span><span class="flex-1">Supprimer le compte</span><span>›</span></button>
            </div>
            <form id="delete-account-confirmation" class="delete-confirmation" method="post" action="{{ path('app_profile_delete') }}" hidden>
                <strong class="text-sm text-red-700">Suppression définitive</strong>
                <p class="mt-2 text-xs leading-5 text-slate-600">Cette action supprimera définitivement votre profil, votre journal et vos données. Saisissez votre mot de passe pour confirmer.</p>
                <label for="delete-password" class="sr-only">Mot de passe actuel</label>
                <input id="delete-password" type="password" name="password" autocomplete="current-password" required placeholder="Mot de passe actuel">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-account') }}">
                <button type="submit">Supprimer définitivement mon compte</button>
            </form>
        </section>

        <section class="privacy-protection text-center"><span class="privacy-protection-icon">♙</span><strong class="mt-4 block text-xs">Vos données sont protégées</strong><p class="mx-auto mt-2 max-w-sm text-[10px] leading-4 text-slate-500">FitProgress met en œuvre le hachage des mots de passe, une protection CSRF et des accès sécurisés par rôle pour protéger vos données.</p></section>
    </main>
    {% if is_granted('ROLE_COACH') and not is_granted('ROLE_ADMIN') %}{% include 'components/_coach_navigation.html.twig' with {active:'profile'} %}{% else %}{% include 'components/_app_navigation.html.twig' with {active: 'profile'} %}{% endif %}
</div>
{% endblock %}
