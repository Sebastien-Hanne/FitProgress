{% extends 'base.html.twig' %}
{% block title %}Changer l’adresse e-mail | FitProgress{% endblock %}
{% block body %}<div class="fit-page fit-text min-h-screen font-sans">{% include 'components/_app_header.html.twig' %}<main class="mx-auto max-w-2xl px-4 pb-28 pt-8"><a href="{{ path('app_profile_account') }}" class="text-sm font-black text-emerald-700">← Retour aux paramètres</a><h1 class="mt-8 text-3xl font-black">Changer l’adresse e-mail</h1><p class="mt-3 text-sm leading-6 text-slate-500">Un lien valable une heure sera envoyé à la nouvelle adresse. Votre adresse actuelle restera active jusqu’à la confirmation.</p>{% for message in app.flashes('email_error') %}<p class="mt-4 rounded-xl bg-red-50 p-3 text-xs font-bold text-red-700">{{ message }}</p>{% endfor %}<section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">{{ form_start(emailForm) }}{% for field in [emailForm.newEmail, emailForm.currentPassword] %}<div class="mb-4"><div class="mb-2 text-xs font-bold">{{ form_label(field) }}</div>{{ form_widget(field, {attr: {class: 'w-full rounded-xl border border-slate-300 p-3 text-sm'}}) }}<div class="mt-1 text-xs text-red-600">{{ form_errors(field) }}</div></div>{% endfor %}<button class="w-full rounded-xl bg-emerald-500 p-3 text-sm font-black text-white">Envoyer le lien de confirmation</button>{{ form_end(emailForm) }}</section></main></div>{% endblock %}
