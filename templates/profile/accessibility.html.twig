{% extends 'base.html.twig' %}

{% block title %}Accessibilité | FitProgress{% endblock %}

{% block stylesheets %}
<style>
    .accessibility-main { width: 100%; max-width: 48rem; margin-inline: auto; padding-bottom: 9rem !important; }
    .accessibility-title { display: inline-flex; align-items: center; gap: .75rem; margin-top: 1.5rem; margin-bottom: 2rem; color: #007a5e; font-size: 1.35rem; font-weight: 900; text-decoration: none; }
    .accessibility-back { display: flex; width: 2.25rem; height: 2.25rem; align-items: center; justify-content: center; border-radius: 999px; color: #007a5e; font-size: 1.5rem; text-decoration: none; transition: .2s; }
    .accessibility-back:hover { background: #dff7ef; }
    .accessibility-introduction { margin-bottom: 2.5rem; }
    .accessibility-eyebrow { color: #008567; font-size: .65rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
    .accessibility-heading { margin-top: 1rem; color: #1a2b48; font-size: 2rem; font-weight: 900; line-height: 1.05; }
    .accessibility-description { max-width: 42rem; margin-top: 1rem; color: #64748b; font-size: .9rem; line-height: 1.65; }
    .accessibility-card { overflow: hidden; border: 1px solid #cddcf5; border-radius: .85rem; background: #fff; box-shadow: 0 2px 5px rgba(15,23,42,.06); }
    .accessibility-card + .accessibility-card { margin-top: 1.5rem; }
    .accessibility-card-title { padding: .9rem 1rem; border-bottom: 1px solid #cddcf5; color: #007a5e; font-size: .75rem; font-weight: 800; }
    .accessibility-row { display: flex; min-height: 5rem; align-items: center; gap: 1rem; margin-inline: 1rem; padding-block: 1rem; }
    .accessibility-row + .accessibility-row { border-top: 1px solid #dbe5f5; }
    .accessibility-copy { min-width: 0; flex: 1; }
    .accessibility-copy strong { display: block; font-size: .82rem; font-weight: 500; }
    .accessibility-copy small { display: block; margin-top: .35rem; color: #64748b; font-size: .62rem; line-height: 1.35; }
    .accessibility-switch { position: relative; display: block; width: 2.75rem; height: 1.5rem; border-radius: 999px; background: #dbe7fb; cursor: pointer; transition: .2s; }
    .accessibility-switch::after { content: ''; position: absolute; top: .2rem; left: .2rem; width: 1.1rem; height: 1.1rem; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(15,23,42,.15); transition: .2s; }
    input:checked + .accessibility-switch { background: #00b887; }
    input:checked + .accessibility-switch::after { transform: translateX(1.25rem); }
    .accessibility-range { width: 100%; accent-color: #00b887; }
    .accessibility-range-line { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .65rem; margin-top: .75rem; font-size: .8rem; }
    .fit-high-contrast body { background: #fff !important; color: #000 !important; filter: none; }
    .fit-high-contrast .accessibility-card { border: 2px solid #111827 !important; background: #fff !important; color: #000 !important; }
    .fit-high-contrast .accessibility-card-title, .fit-high-contrast .accessibility-copy small { color: #000 !important; }
    .fit-dark-mode body, .fit-dark-mode .fit-page { background: #111827 !important; color: #f8fafc !important; }
    .fit-dark-mode .accessibility-card, .fit-dark-mode .app-header, .fit-dark-mode .app-navigation { border-color: #475569 !important; background: #1f2937 !important; color: #f8fafc !important; }
    .fit-dark-mode .accessibility-copy small { color: #cbd5e1 !important; }
    @media (min-width: 1024px) { .accessibility-main { padding: 2.5rem 2rem 9rem !important; } }
</style>
{% endblock %}

{% block body %}
<div class="fit-page fit-text min-h-screen font-sans" id="accessibility-page">
    {% include 'components/_app_header.html.twig' %}
    <main class="accessibility-main space-y-6 px-4 pb-28 pt-5">
        <a href="{{ path(is_granted('ROLE_COACH') and not is_granted('ROLE_ADMIN') ? 'app_coach_space_profile' : 'app_profile') }}" class="accessibility-title" aria-label="Retour au profil"><span class="accessibility-back" aria-hidden="true">←</span><span>Retour au profil</span></a>
        <p class="sr-only" aria-live="polite" id="accessibility-status"></p>
        <div class="accessibility-introduction">
            <p class="accessibility-eyebrow">Accessibilité</p>
            <h1 class="accessibility-heading">Une application,<br>adaptée à vos besoins</h1>
            <p class="accessibility-description">Personnalisez l’affichage, les interactions et l’audio pour profiter d’une expérience FitProgress plus confortable.</p>
        </div>

        <section class="accessibility-card" aria-labelledby="display-title">
            <h2 id="display-title" class="accessibility-card-title">◉ &nbsp;Affichage</h2>
            <div class="accessibility-row"><div class="accessibility-copy"><strong>Taille du texte : <output id="accessibility-size-output" for="accessibility-size">100 %</output></strong><small>Ajustez la taille du texte pour une meilleure lisibilité.</small><div class="accessibility-range-line"><span>A</span><input id="accessibility-size" type="range" min="80" max="150" step="5" value="100" class="accessibility-range" aria-label="Taille du texte"><span class="text-base">A</span></div></div></div>
            <div class="accessibility-row"><div class="accessibility-copy"><strong>Contraste élevé</strong><small>Augmente la différence entre les couleurs.</small></div><label><span class="sr-only">Contraste élevé</span><input id="accessibility-contrast" type="checkbox" class="sr-only" aria-label="Activer ou désactiver le contraste élevé"><span class="accessibility-switch"></span></label></div>
            <div class="accessibility-row"><div class="accessibility-copy"><strong>Mode sombre</strong><small>Force le thème sombre.</small></div><label><span class="sr-only">Mode sombre</span><input id="accessibility-dark" type="checkbox" class="sr-only" aria-label="Activer ou désactiver le mode sombre"><span class="accessibility-switch"></span></label></div>
        </section>

        <section class="accessibility-card" aria-labelledby="interaction-title">
            <h2 id="interaction-title" class="accessibility-card-title">♿ &nbsp;Interaction</h2>
            <div class="accessibility-row"><div class="accessibility-copy"><strong>Retours haptiques</strong><small>Vibration lors des interactions sur les appareils compatibles.</small></div><label><span class="sr-only">Retours haptiques</span><input id="accessibility-haptics" type="checkbox" class="sr-only" aria-label="Activer ou désactiver les vibrations"><span class="accessibility-switch"></span></label></div>
            <div class="accessibility-row"><div class="accessibility-copy"><strong>Assistance vocale</strong><small>Lit les éléments interactifs lorsqu’ils reçoivent le focus.</small></div><label><span class="sr-only">Assistance vocale</span><input id="accessibility-voice" type="checkbox" class="sr-only" aria-label="Activer ou désactiver l’assistance vocale"><span class="accessibility-switch"></span></label></div>
            <div class="accessibility-row"><div class="accessibility-copy"><strong>Réduire les animations</strong><small>Limite les transitions et mouvements non essentiels.</small></div><label><span class="sr-only">Réduire les animations</span><input id="accessibility-motion" type="checkbox" class="sr-only" aria-label="Activer ou désactiver la réduction des animations"><span class="accessibility-switch"></span></label></div>
        </section>
        <button id="accessibility-reset" type="button" class="w-full rounded-xl border border-slate-300 bg-white p-3 text-xs font-black">Réinitialiser les préférences</button>

        <section class="accessibility-card" aria-labelledby="audio-title">
            <h2 id="audio-title" class="accessibility-card-title">◖ &nbsp;Audio</h2>
            <div class="accessibility-row"><div class="accessibility-copy"><strong>Sous-titres pour vidéos</strong><small>Active les sous-titres par défaut pour les futurs entraînements vidéo.</small></div><label><span class="sr-only">Sous-titres pour vidéos</span><input id="accessibility-captions" type="checkbox" class="sr-only" aria-label="Activer ou désactiver les sous-titres"><span class="accessibility-switch"></span></label></div>
        </section>
    </main>
    {% if is_granted('ROLE_COACH') and not is_granted('ROLE_ADMIN') %}{% include 'components/_coach_navigation.html.twig' with {active:'profile'} %}{% else %}{% include 'components/_app_navigation.html.twig' with {active: 'profile'} %}{% endif %}
</div>
<script>
(() => {
    const initializeAccessibility = () => {
        const page = document.getElementById('accessibility-page');
        if (!page || page.dataset.initialized === 'true') return;
        page.dataset.initialized = 'true';

        const controls = {
            size: document.getElementById('accessibility-size'),
            contrast: document.getElementById('accessibility-contrast'),
            dark: document.getElementById('accessibility-dark'),
            haptics: document.getElementById('accessibility-haptics'),
            voice: document.getElementById('accessibility-voice'),
            captions: document.getElementById('accessibility-captions')
            , motion: document.getElementById('accessibility-motion')
        };
        const read = (key) => localStorage.getItem(key) === 'true';
        controls.size.value = localStorage.getItem('fit-accessibility-size') || '100';
        controls.contrast.checked = read('fit-high-contrast');
        controls.dark.checked = read('fit-dark-mode');
        controls.haptics.checked = read('fit-haptics');
        controls.voice.checked = read('fit-voice-assistance');
        controls.captions.checked = read('fit-video-captions');
        controls.motion.checked = localStorage.getItem('fit-reduced-motion') === null
            ? window.matchMedia('(prefers-reduced-motion: reduce)').matches : read('fit-reduced-motion');

        const apply = () => {
            document.documentElement.style.fontSize = controls.size.value + '%';
            document.documentElement.classList.toggle('fit-high-contrast', controls.contrast.checked);
            document.documentElement.classList.toggle('fit-dark-mode', controls.dark.checked);
            document.documentElement.classList.toggle('fit-voice-assistance', controls.voice.checked);
            document.documentElement.dataset.haptics = String(controls.haptics.checked);
            document.documentElement.dataset.videoCaptions = String(controls.captions.checked);
            document.documentElement.classList.toggle('fit-reduced-motion', controls.motion.checked);
            document.getElementById('accessibility-size-output').value = controls.size.value + ' %';
        };
        const save = () => {
            const voiceWasEnabled = localStorage.getItem('fit-voice-assistance') === 'true';
            localStorage.setItem('fit-accessibility-size', controls.size.value);
            localStorage.setItem('fit-high-contrast', controls.contrast.checked);
            localStorage.setItem('fit-dark-mode', controls.dark.checked);
            localStorage.setItem('fit-haptics', controls.haptics.checked);
            localStorage.setItem('fit-voice-assistance', controls.voice.checked);
            localStorage.setItem('fit-video-captions', controls.captions.checked);
            localStorage.setItem('fit-reduced-motion', controls.motion.checked);
            apply();
            document.getElementById('accessibility-status').textContent = 'Préférences enregistrées.';
            if (controls.haptics.checked && navigator.vibrate) navigator.vibrate(35);
            if (controls.voice.checked && !voiceWasEnabled) {
                window.fitSpeak?.('Assistance vocale activée. Utilisez la touche tabulation pour parcourir les éléments.');
            }
        };

        Object.values(controls).forEach((control) => {
            control.addEventListener(control.type === 'range' ? 'input' : 'change', save);
        });
        document.getElementById('accessibility-reset').addEventListener('click', () => {
            ['fit-accessibility-size', 'fit-high-contrast', 'fit-dark-mode', 'fit-haptics', 'fit-voice-assistance', 'fit-video-captions', 'fit-reduced-motion'].forEach((key) => localStorage.removeItem(key));
            controls.size.value = '100';
            controls.contrast.checked = controls.dark.checked = controls.haptics.checked = controls.voice.checked = controls.captions.checked = controls.motion.checked = false;
            apply();
            document.getElementById('accessibility-status').textContent = 'Préférences réinitialisées.';
        });
        apply();
    };

    initializeAccessibility();
    document.addEventListener('turbo:load', initializeAccessibility);
})();
</script>
{% endblock %}
