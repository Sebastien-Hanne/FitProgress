{% extends 'base.html.twig' %}

{% block title %}Inscription Coach | FitProgress{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-500/80 flex items-center justify-center p-4 py-8 font-sans">
    <div class="max-w-md w-full bg-[#f4f9fb] rounded-[2.5rem] shadow-2xl p-7 border border-slate-100">

        {# Messages Flash #}
        {% for message in app.flashes('success') %}
            <div class="mb-4 p-3 text-xs font-semibold text-emerald-800 bg-emerald-100/80 rounded-2xl border border-emerald-200">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mb-4 p-3 text-xs font-semibold text-red-800 bg-red-100/80 rounded-2xl border border-red-200">
                {{ message }}
            </div>
        {% endfor %}

        {# En-tête Coach #}
        <div class="text-center mb-5">
            <h2 class="text-2xl font-black text-[#1a2b48] mb-2 leading-tight">Donnez des ailes au<br>changement</h2>
            <p class="text-[11px] text-slate-500 leading-relaxed px-2">
                Rejoignez notre réseau d'élite de coachs professionnels et amplifiez votre impact.
            </p>
        </div>

        {# Navigation Onglets #}
        <div class="bg-slate-200/50 p-1 rounded-2xl flex mb-5">
            <a href="{{ path('app_register') }}" class="flex-1 py-2 text-center text-xs font-bold rounded-xl text-slate-400 hover:text-slate-700 transition-all">Progressor</a>
            <span class="flex-1 py-2 text-center text-xs font-bold rounded-xl bg-white text-emerald-600 shadow-sm">Coach</span>
        </div>

        {{ form_start(registrationForm, {'attr': {'class': 'space-y-3.5', 'novalidate': 'novalidate'}}) }}
            
            <div id="specialities-hidden-inputs"></div>

            {# --- CHAMP NOM --- #}
            {% set input_class = 'w-full pl-4 pr-10 py-2.5 bg-white rounded-2xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 transition-all ' %}
            {% if form_errors(registrationForm.name)|length > 0 %}
                {% set input_class = input_class ~ 'border border-red-500 focus:ring-red-400' %}
            {% else %}
                {% set input_class = input_class ~ 'border border-emerald-300/60 focus:ring-emerald-400' %}
            {% endif %}
            <div>
                <label class="block text-xs font-bold text-[#1a2b48] mb-1">Nom Prénom</label>
                <div class="relative">
                    {{ form_widget(registrationForm.name, { 'attr': { 'class': input_class, 'placeholder': 'Coach Sarah Miller' } }) }}
                    <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    </div>
                </div>
                <div class="text-[10px] text-red-500 mt-0.5 min-h-[1rem]">{{ form_errors(registrationForm.name) }}</div>
            </div>

            {# --- CHAMP EMAIL --- #}
            {% set input_class = 'w-full pl-4 pr-10 py-2.5 bg-white rounded-2xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 transition-all ' %}
            {% if form_errors(registrationForm.email)|length > 0 %}
                {% set input_class = input_class ~ 'border border-red-500 focus:ring-red-400' %}
            {% else %}
                {% set input_class = input_class ~ 'border border-emerald-300/60 focus:ring-emerald-400' %}
            {% endif %}
            <div>
                <label class="block text-xs font-bold text-[#1a2b48] mb-1">Email Professionnel</label>
                <div class="relative">
                    {{ form_widget(registrationForm.email, { 'attr': { 'class': input_class, 'placeholder': 'sarah.coach@gmail.com' } }) }}
                    <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    </div>
                </div>
                <div class="text-[10px] text-red-500 mt-0.5 min-h-[1rem]">{{ form_errors(registrationForm.email) }}</div>
            </div>

            {# --- CHAMP MOT DE PASSE --- #}
            {% set input_class = 'w-full pl-4 pr-10 py-2.5 bg-white rounded-2xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 transition-all ' %}
            {% if form_errors(registrationForm.plainPassword.first)|length > 0 or form_errors(registrationForm.plainPassword)|length > 0 %}
                {% set input_class = input_class ~ 'border border-red-500 focus:ring-red-400' %}
            {% else %}
                {% set input_class = input_class ~ 'border border-emerald-300/60 focus:ring-emerald-400' %}
            {% endif %}
            <div>
                <label class="block text-xs font-bold text-[#1a2b48] mb-1">Mot de passe</label>
                <div class="relative">
                    {{ form_widget(registrationForm.plainPassword.first, { 'attr': { 'class': input_class, 'placeholder': '••••••••' } }) }}
                    <button type="button" onclick="togglePasswordVisibility('{{ registrationForm.plainPassword.first.vars.id }}', this)" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-emerald-600 focus:outline-none transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    </button>
                </div>
                {# Indicateurs dynamiques #}
                <div class="mt-2 text-[10px]" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:1rem;row-gap:.5rem">
                    <span id="indicator-length" class="flex items-center gap-1 text-slate-400 transition-colors">
                        <span class="indicator-icon w-2.5 h-2.5 rounded-full border border-slate-300 inline-block"></span>
                        8+ Caractères
                    </span>
                    <span id="indicator-special" class="flex items-center gap-1 text-slate-400 transition-colors">
                        <span class="indicator-icon w-2.5 h-2.5 rounded-full border border-slate-300 inline-block"></span>
                        Caractère Spécial
                    </span>
                    <span id="indicator-uppercase" class="flex items-center gap-1 text-slate-400 transition-colors"><span class="indicator-icon w-2.5 h-2.5 rounded-full border border-slate-300 inline-block"></span>1 majuscule</span>
                    <span id="indicator-lowercase" class="flex items-center gap-1 text-slate-400 transition-colors"><span class="indicator-icon w-2.5 h-2.5 rounded-full border border-slate-300 inline-block"></span>1 minuscule</span>
                    <span id="indicator-number" class="flex items-center gap-1 text-slate-400 transition-colors"><span class="indicator-icon w-2.5 h-2.5 rounded-full border border-slate-300 inline-block"></span>1 chiffre</span>
                </div>
                <div class="text-[10px] text-red-500 mt-0.5 min-h-[1rem]">
                    {{ form_errors(registrationForm.plainPassword) }}
                    {{ form_errors(registrationForm.plainPassword.first) }}
                </div>
            </div>

            {# --- CHAMP CONFIRMATION --- #}
            {% if registrationForm.plainPassword.second is defined %}
                {% set input_class = 'w-full pl-4 pr-10 py-2.5 bg-white rounded-2xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 transition-all ' %}
                {% if form_errors(registrationForm.plainPassword.second)|length > 0 or form_errors(registrationForm.plainPassword)|length > 0 %}
                    {% set input_class = input_class ~ 'border border-red-500 focus:ring-red-400' %}
                {% else %}
                    {% set input_class = input_class ~ 'border border-emerald-300/60 focus:ring-emerald-400' %}
                {% endif %}
                <div>
                    <label class="block text-xs font-bold text-[#1a2b48] mb-1">Confirmez le mot de passe</label>
                    <div class="relative">
                        {{ form_widget(registrationForm.plainPassword.second, { 'attr': { 'class': input_class, 'placeholder': '••••••••' } }) }}
                        <button type="button" onclick="togglePasswordVisibility('{{ registrationForm.plainPassword.second.vars.id }}', this)" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-emerald-600 focus:outline-none transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        </button>
                    </div>
                    <div class="text-[10px] text-red-500 mt-0.5 min-h-[1rem]">
                        {{ form_errors(registrationForm.plainPassword.second) }}
                    </div>
                </div>
            {% endif %}

            {# --- SPÉCIALISATIONS --- #}
            <div>
                <label class="block text-xs font-bold text-[#1a2b48] mb-1.5">Spécialisations (sélection multiple)</label>
                <div id="specialities-container" class="flex flex-wrap gap-1.5">
                    <button type="button" onclick="toggleSpecialty(this, 'Perte de poids')" class="specialty-btn flex items-center gap-1 px-3 py-1.5 bg-white border border-slate-200 text-slate-700 text-[11px] font-bold rounded-full transition-all shadow-sm hover:border-emerald-400 cursor-pointer">
                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M5 8h14l1.2 12H3.8L5 8Z"/><path stroke-linecap="round" stroke-width="1.9" d="M8.5 8a3.5 3.5 0 0 1 7 0M12 11l2-1.5"/></svg>
                        Perte de poids
                    </button>
                    <button type="button" onclick="toggleSpecialty(this, 'Yoga et mobilité')" class="specialty-btn flex items-center gap-1 px-3 py-1.5 bg-white border border-slate-200 text-slate-700 text-[11px] font-bold rounded-full transition-all shadow-sm hover:border-emerald-400 cursor-pointer">
                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="2" stroke-width="1.9"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 7v5m0 0-4 7m4-7 4 7M7 10l5 2 5-2"/></svg>
                        Yoga et mobilité
                    </button>
                    <button type="button" onclick="toggleSpecialty(this, 'Musculation')" class="specialty-btn flex items-center gap-1 px-3 py-1.5 bg-white border border-slate-200 text-slate-700 text-[11px] font-bold rounded-full transition-all shadow-sm hover:border-emerald-400 cursor-pointer">
                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M7 12h10M5 8v8m14-8v8M2.5 10v4m19-4v4"/></svg>
                        Musculation
                    </button>
                    <button type="button" onclick="toggleSpecialty(this, 'HIIT')" class="specialty-btn flex items-center gap-1 px-3 py-1.5 bg-white border border-slate-200 text-slate-700 text-[11px] font-bold rounded-full transition-all shadow-sm hover:border-emerald-400 cursor-pointer">
                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8" stroke-width="1.8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 2h6m-3 3V2m1 7-3 5h3l-2 4"/></svg>
                        HIIT
                    </button>
                    <button type="button" id="add-specialty-btn" onclick="promptAddSpecialty()" class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-sm shadow-md hover:bg-emerald-600 transition-all cursor-pointer" aria-label="Ajouter une spécialisation"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg></button>
                </div>
            </div>

            {# --- CERTIFICATION --- #}
            {% set input_class = 'w-full pl-4 pr-10 py-2.5 bg-white rounded-2xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 transition-all ' %}
            {% if form_errors(registrationForm.certification)|length > 0 %}
                {% set input_class = input_class ~ 'border border-red-500 focus:ring-red-400' %}
            {% else %}
                {% set input_class = input_class ~ 'border border-emerald-300/60 focus:ring-emerald-400' %}
            {% endif %}
            <div>
                <label class="block text-xs font-bold text-[#1a2b48] mb-1">Certification professionnelle</label>
                <div class="relative">
                    {{ form_widget(registrationForm.certification, { 'attr': { 'class': input_class, 'placeholder': 'NASM-12345678' } }) }}
                    <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    </div>
                </div>
                <div class="text-[10px] text-red-500 mt-0.5 min-h-[1rem]">{{ form_errors(registrationForm.certification) }}</div>
                <p class="text-[9px] text-slate-400 italic">Les références seront vérifiées par notre équipe.</p>
            </div>

            {# --- CASE CGU --- #}
            {% if registrationForm.agreeTerms is defined %}
            <div>
                <div class="flex items-start gap-2 pt-1">
                    {{ form_widget(registrationForm.agreeTerms, { 'attr': {'class': 'mt-0.5 rounded border-slate-300 text-emerald-500 focus:ring-emerald-400 w-3.5 h-3.5'} }) }}
                    <label for="{{ registrationForm.agreeTerms.vars.id }}" class="text-[10px] text-slate-600 leading-tight cursor-pointer">
                        J'accepte l'<a href="#" class="text-emerald-700 font-bold hover:underline">accord de service</a> et la <a href="#" class="text-emerald-700 font-bold hover:underline">Politique de confidentialité</a>.
                    </label>
                </div>
                <div class="text-[10px] text-red-500 mt-0.5 min-h-[1rem]">{{ form_errors(registrationForm.agreeTerms) }}</div>
            </div>
            {% endif %}

            {# --- BOUTON DE VALIDATION --- #}
            <button type="submit" class="w-full mt-3 bg-[#10b981] hover:bg-[#059669] active:scale-[0.99] text-white font-black py-3 px-4 rounded-2xl shadow-lg shadow-emerald-500/20 transition-all flex items-center justify-center gap-2 text-xs cursor-pointer">
                <span>Rejoignez-nous en tant que coach</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>

            {% if registrationForm._token is defined %}
                {{ form_widget(registrationForm._token) }}
            {% endif %}
        {{ form_end(registrationForm, {'render_rest': false}) }}

        {# Pied de page #}
        <div class="mt-5 pt-3 text-center text-xs text-slate-500">
            Vous avez déjà un compte ?
            <a href="{{ path('app_login') }}" class="text-emerald-600 font-bold hover:underline ml-1">Connectez-vous</a>
        </div>
    </div>
</div>

<script>
    // 1. Visibilité Mot de passe
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        if (!input) return;
        if (input.type === 'password') {
            input.type = 'text';
            btn.classList.add('text-emerald-600');
            btn.classList.remove('text-slate-400');
        } else {
            input.type = 'password';
            btn.classList.remove('text-emerald-600');
            btn.classList.add('text-slate-400');
        }
    }

    // 2. Initialisation des règles dynamiques (compatible Turbo & Standard)
    function initPasswordIndicators() {
        const passwordInput = document.getElementById('{{ registrationForm.plainPassword.first.vars.id }}');
        const indicatorLength = document.getElementById('indicator-length');
        const indicatorSpecial = document.getElementById('indicator-special');
        const indicatorUppercase = document.getElementById('indicator-uppercase');
        const indicatorLowercase = document.getElementById('indicator-lowercase');
        const indicatorNumber = document.getElementById('indicator-number');

        if (passwordInput && indicatorLength && indicatorSpecial && indicatorUppercase && indicatorLowercase && indicatorNumber && passwordInput.dataset.indicatorsInitialized !== 'true') {
            passwordInput.dataset.indicatorsInitialized = 'true';
            const refreshIndicators = function() {
                const password = this.value;
                updateIndicator(indicatorLength, password.length >= 8);
                updateIndicator(indicatorSpecial, /[^\p{L}\p{N}\s]/u.test(password));
                updateIndicator(indicatorUppercase, /[A-Z]/.test(password));
                updateIndicator(indicatorLowercase, /[a-z]/.test(password));
                updateIndicator(indicatorNumber, /[0-9]/.test(password));
            };
            passwordInput.addEventListener('input', refreshIndicators);
            refreshIndicators.call(passwordInput);
        }
    }

    function updateIndicator(element, isValid) {
        const circleHtml = '<span class="indicator-icon w-2.5 h-2.5 rounded-full border border-slate-300 inline-block"></span>';
        const checkHtml = '<svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>';
        const iconContainer = element.querySelector('.indicator-icon, svg');
        if (iconContainer) iconContainer.outerHTML = isValid ? checkHtml : circleHtml;

        if (isValid) {
            element.classList.remove('text-slate-400');
            element.classList.add('text-emerald-600', 'font-semibold');
        } else {
            element.classList.remove('text-emerald-600', 'font-semibold');
            element.classList.add('text-slate-400');
        }
    }

    // 3. Gestion des Badges de Spécialités
    function toggleSpecialty(btn, value) {
        const isSelected = btn.classList.contains('border-emerald-500');
        const hiddenInputsContainer = document.getElementById('specialities-hidden-inputs');

        if (isSelected) {
            btn.classList.remove('border-emerald-500', 'text-emerald-600', 'bg-emerald-50/70', 'ring-1', 'ring-emerald-500');
            btn.classList.add('border-slate-200', 'text-slate-700', 'bg-white');
            const existingInput = hiddenInputsContainer.querySelector(`input[value="${CSS.escape(value)}"]`);
            if (existingInput) existingInput.remove();
        } else {
            btn.classList.remove('border-slate-200', 'text-slate-700', 'bg-white');
            btn.classList.add('border-emerald-500', 'text-emerald-600', 'bg-emerald-50/70', 'ring-1', 'ring-emerald-500');
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'specialities[]';
            input.value = value;
            hiddenInputsContainer.appendChild(input);
        }
    }

    function promptAddSpecialty() {
        const name = prompt("Quelle est votre spécialisation ?");
        if (name && name.trim() !== "") {
            const specialtyName = name.trim();
            const container = document.getElementById('specialities-container');
            const plusBtn = document.getElementById('add-specialty-btn');
            if (!container || !plusBtn) return;

            const newBtn = document.createElement('button');
            newBtn.type = 'button';
            newBtn.className = 'specialty-btn flex items-center gap-1 px-3 py-1.5 bg-white border border-slate-200 text-slate-700 text-[11px] font-bold rounded-full transition-all shadow-sm hover:border-emerald-400 cursor-pointer';
            newBtn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>${specialtyName}</span>`;
            newBtn.onclick = function() { toggleSpecialty(this, specialtyName); };
            container.insertBefore(newBtn, plusBtn);
            toggleSpecialty(newBtn, specialtyName);
        }
    }

    document.addEventListener('DOMContentLoaded', initPasswordIndicators);
    document.addEventListener('turbo:load', initPasswordIndicators);
</script>
{% endblock %}
