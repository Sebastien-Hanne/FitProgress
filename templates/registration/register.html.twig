{% extends 'base.html.twig' %}

{% block title %}Inscription Progressor | FitProgress{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-500/80 flex items-center justify-center p-4 py-8 font-sans">
    <div class="max-w-md w-full bg-[#f4f9fb] rounded-[2.5rem] shadow-2xl p-7 border border-slate-100">

        {# Messages Flash #}
        {% for message in app.flashes('success') %}
            <div class="mb-4 p-3 text-xs font-semibold text-emerald-800 bg-emerald-100/80 rounded-2xl border border-emerald-200">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mb-4 p-3 text-xs font-semibold text-red-800 bg-red-100/80 rounded-2xl border border-red-200">
                {{ message }}
            </div>
        {% endfor %}

        {# En-tête #}
        <div class="text-center mb-5">
            <h2 class="text-2xl font-black text-[#1a2b48] mb-2">Créer un compte</h2>
            <p class="text-[11px] text-slate-500 leading-relaxed px-4">
                Suivez votre évolution au quotidien et atteignez vos objectifs de poids en toute simplicité.
            </p>
        </div>

        {# Navigation Onglets #}
        <div class="bg-slate-200/50 p-1 rounded-2xl flex mb-5">
            <span class="flex-1 py-2 text-center text-xs font-bold rounded-xl bg-white text-slate-800 shadow-sm">Progressor</span>
            <a href="{{ path('app_register_coach') }}" class="flex-1 py-2 text-center text-xs font-bold rounded-xl text-emerald-600 hover:text-emerald-700 transition-all">Coach</a>
        </div>

        {{ form_start(registrationForm, {'attr': {'class': 'space-y-3.5', 'novalidate': 'novalidate'}}) }}

            {# --- CHAMP NOM --- #}
            {% set has_name_error = registrationForm.name.vars.submitted and not registrationForm.name.vars.valid %}
            {% set input_class = 'w-full pl-4 pr-10 py-2.5 bg-white rounded-2xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 transition-all ' ~ 
                (has_name_error ? 'border border-red-500 focus:ring-red-400' : 'border border-emerald-300/60 focus:ring-emerald-400') %}

            <div>
                <label class="block text-xs font-bold text-[#1a2b48] mb-1">Nom d'utilisateur</label>
                <div class="relative">
                    {{ form_widget(registrationForm.name, { 'attr': { 'class': input_class, 'placeholder': 'fitness_pro' } }) }}
                    <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    </div>
                </div>
                <div class="text-[10px] text-red-500 mt-0.5 min-h-[1rem]">{{ form_errors(registrationForm.name) }}</div>
            </div>

            {# --- CHAMP EMAIL --- #}
            {% set has_email_error = registrationForm.email.vars.submitted and not registrationForm.email.vars.valid %}
            {% set input_class = 'w-full pl-4 pr-10 py-2.5 bg-white rounded-2xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 transition-all ' ~ 
                (has_email_error ? 'border border-red-500 focus:ring-red-400' : 'border border-emerald-300/60 focus:ring-emerald-400') %}

            <div>
                <label class="block text-xs font-bold text-[#1a2b48] mb-1">Email</label>
                <div class="relative">
                    {{ form_widget(registrationForm.email, { 'attr': { 'class': input_class, 'placeholder': 'nom@exemple.com' } }) }}
                    <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    </div>
                </div>
                <div class="text-[10px] text-red-500 mt-0.5 min-h-[1rem]">{{ form_errors(registrationForm.email) }}</div>
            </div>

            {# --- CHAMP MOT DE PASSE --- #}
            {% set has_pwd_error = not registrationForm.plainPassword.vars.valid or not registrationForm.plainPassword.first.vars.valid %}
            {% set input_class = 'w-full pl-4 pr-10 py-2.5 bg-white rounded-2xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 transition-all ' ~ 
                (has_pwd_error ? 'border border-red-500 focus:ring-red-400' : 'border border-emerald-300/60 focus:ring-emerald-400') %}

            <div>
                <label class="block text-xs font-bold text-[#1a2b48] mb-1">Mot de passe</label>
                <div class="relative">
                    {{ form_widget(registrationForm.plainPassword.first, { 'attr': { 'class': input_class, 'placeholder': '••••••••' } }) }}
                    <button type="button" onclick="togglePasswordVisibility('{{ registrationForm.plainPassword.first.vars.id }}', this)" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-emerald-600 focus:outline-none transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    </button>
                </div>
                
                {# Indicateurs dynamiques #}
                <div class="flex items-center gap-3 mt-1.5 text-[10px]">
                    <span id="indicator-length" class="flex items-center gap-1 text-slate-400 transition-colors">
                        <span class="indicator-icon w-2.5 h-2.5 rounded-full border border-slate-300 inline-block"></span>
                        8+ Caractères
                    </span>
                    <span id="indicator-special" class="flex items-center gap-1 text-slate-400 transition-colors">
                        <span class="indicator-icon w-2.5 h-2.5 rounded-full border border-slate-300 inline-block"></span>
                        Caractère Spécial
                    </span>
                </div>
                
                {# Affichage des erreurs de mot de passe #}
                <div class="text-[10px] text-red-500 mt-0.5 min-h-[1rem]">
                    {{ form_errors(registrationForm.plainPassword) }}
                    {{ form_errors(registrationForm.plainPassword.first) }}
                </div>
            </div>

            {# --- CHAMP CONFIRMATION MOT DE PASSE --- #}
            {% if registrationForm.plainPassword.second is defined %}
                {% set has_confirm_error = not registrationForm.plainPassword.vars.valid or not registrationForm.plainPassword.second.vars.valid %}
                {% set input_class = 'w-full pl-4 pr-10 py-2.5 bg-white rounded-2xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 transition-all ' ~ 
                    (has_confirm_error ? 'border border-red-500 focus:ring-red-400' : 'border border-emerald-300/60 focus:ring-emerald-400') %}

                <div>
                    <label class="block text-xs font-bold text-[#1a2b48] mb-1">Confirmez le mot de passe</label>
                    <div class="relative">
                        {{ form_widget(registrationForm.plainPassword.second, { 'attr': { 'class': input_class, 'placeholder': '••••••••' } }) }}
                        <button type="button" onclick="togglePasswordVisibility('{{ registrationForm.plainPassword.second.vars.id }}', this)" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-emerald-600 focus:outline-none transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        </button>
                    </div>
                    <div class="text-[10px] text-red-500 mt-0.5 min-h-[1rem]">
                        {{ form_errors(registrationForm.plainPassword.second) }}
                    </div>
                </div>
            {% endif %}

            {# --- CGU --- #}
            {% if registrationForm.agreeTerms is defined %}
                <div class="flex items-start gap-2 pt-1">
                    {{ form_widget(registrationForm.agreeTerms, {
                        'attr': {
                            'class': 'mt-0.5 w-3.5 h-3.5 rounded border-slate-300 text-emerald-500 focus:ring-emerald-400'
                        }
                    }) }}
                    <label for="{{ registrationForm.agreeTerms.vars.id }}" class="text-[10px] text-slate-600 leading-tight cursor-pointer">
                        J'accepte les <a href="#" class="text-emerald-700 font-bold hover:underline">conditions d'utilisation</a> et la <a href="#" class="text-emerald-700 font-bold hover:underline">politique de confidentialité</a>.
                    </label>
                </div>
                <div class="text-[10px] text-red-500 mt-0.5 min-h-[1rem]">{{ form_errors(registrationForm.agreeTerms) }}</div>
            {% endif %}

            {# Bouton de validation #}
            <button type="submit" class="w-full mt-3 bg-[#10b981] hover:bg-[#059669] active:scale-[0.99] text-white font-black py-3 px-4 rounded-2xl shadow-lg shadow-emerald-500/20 transition-all flex items-center justify-center gap-2 text-xs cursor-pointer">
                <span>Rejoignez le mouvement</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>

        {{ form_end(registrationForm) }}

        {# Pied de page #}
        <div class="mt-5 pt-3 text-center text-xs text-slate-500">
            Vous avez déjà un compte ?
            <a href="{{ path('app_login') }}" class="text-emerald-600 font-bold hover:underline ml-1">Connectez-vous</a>
        </div>

    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        if (!input) return;
        if (input.type === 'password') {
            input.type = 'text';
            btn.classList.add('text-emerald-600');
            btn.classList.remove('text-slate-400');
        } else {
            input.type = 'password';
            btn.classList.remove('text-emerald-600');
            btn.classList.add('text-slate-400');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const passwordInput = document.getElementById('{{ registrationForm.plainPassword.first.vars.id }}');
        const indicatorLength = document.getElementById('indicator-length');
        const indicatorSpecial = document.getElementById('indicator-special');

        if (passwordInput) {
            passwordInput.addEventListener('input', function() {
                const password = this.value;
                const isLongEnough = password.length >= 8;
                updateIndicator(indicatorLength, isLongEnough);

                const hasSpecialChar = /[^a-zA-Z0-9]/.test(password);
                updateIndicator(indicatorSpecial, hasSpecialChar);
            });
        }

        function updateIndicator(element, isValid) {
            const circleHtml = '<span class="indicator-icon w-2.5 h-2.5 rounded-full border border-slate-300 inline-block"></span>';
            const checkHtml = '<svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>';

            const iconContainer = element.querySelector('.indicator-icon, svg');
            if (iconContainer) {
                iconContainer.outerHTML = isValid ? checkHtml : circleHtml;
            }

            if (isValid) {
                element.classList.remove('text-slate-400');
                element.classList.add('text-emerald-600', 'font-semibold');
            } else {
                element.classList.remove('text-emerald-600', 'font-semibold');
                element.classList.add('text-slate-400');
            }
        }
    });
</script>
{% endblock %}