{% extends 'base.html.twig' %}
{% block title %}Votre objectif | FitProgress{% endblock %}
{% block body %}
<div class="min-h-screen bg-slate-500/80 flex items-center justify-center p-4 py-8 font-sans">
    <main class="max-w-md w-full bg-[#f4f9fb] rounded-[2.5rem] shadow-2xl p-7 border border-slate-100">
        <p class="text-[10px] font-extrabold uppercase tracking-[.2em] text-emerald-600">Bienvenue sur FitProgress</p>
        <h1 class="mt-3 text-2xl font-black text-[#1a2b48]">Parlons de votre objectif</h1>
        <p class="mt-2 text-xs leading-5 text-slate-500">Quatre réponses suffisent pour personnaliser votre suivi. Vous pourrez les modifier plus tard.</p>
        {% for message in app.flashes('success') %}<p class="mt-4 rounded-xl bg-emerald-100 p-3 text-xs font-bold text-emerald-800">{{ message }}</p>{% endfor %}
        {{ form_start(onboardingForm, {attr: {class: 'mt-6 space-y-4', novalidate: 'novalidate'}}) }}
            {% set fields = [
                [onboardingForm.heightCm, '175', 'cm'],
                [onboardingForm.initialWeight, '75,0', 'kg'],
                [onboardingForm.targetWeight, '70,0', 'kg'],
                [onboardingForm.birthDate, '', '']
            ] %}
            {% for item in fields %}
                <div>
                    {{ form_label(item[0], null, {label_attr: {class: 'block text-xs font-bold text-[#1a2b48] mb-1'}}) }}
                    <div class="relative">{{ form_widget(item[0], {attr: {class: 'w-full px-4 py-3 bg-white rounded-2xl text-sm text-slate-800 border border-emerald-300 focus:outline-none focus:ring-2 focus:ring-emerald-400', placeholder: item[1]}}) }}{% if item[2] %}<span class="absolute right-4 top-3 text-xs text-slate-400">{{ item[2] }}</span>{% endif %}</div>
                    <div class="mt-1 text-[10px] text-red-600">{{ form_errors(item[0]) }}</div>
                </div>
            {% endfor %}
            <button class="w-full rounded-2xl bg-emerald-500 px-4 py-3 text-xs font-black text-white shadow-lg shadow-emerald-500/20">Commencer mon suivi →</button>
        {{ form_end(onboardingForm) }}
    </main>
</div>
{% endblock %}
