{% extends 'base.html.twig' %}
{% block title %}Dashboard coach | FitProgress{% endblock %}
{% block body %}
<div class="fit-page min-h-screen font-sans text-[#1A2B48]">{% include 'components/_app_header.html.twig' %}
<main class="mx-auto max-w-5xl px-3 pb-24 pt-4 sm:px-6 lg:pt-8">
    {% set filter = filter|default('active') %}
    {% set displayedClientRequests = displayedClientRequests|default(clientRequests) %}
    <p class="text-[0.6rem] font-extrabold uppercase tracking-[.14em] text-slate-500">Gestion</p><h1 class="mt-0.5 text-xl font-black">Liste des Clients</h1>
    <form class="mt-3">{% if filter == 'history' %}<input type="hidden" name="filter" value="history">{% endif %}<label class="sr-only" for="client-search">Rechercher un client</label><input id="client-search" name="q" value="{{ search }}" placeholder="Rechercher un client…" class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-xs outline-none focus:border-emerald-500"></form>

    <section class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4" aria-label="Statistiques coach">
        {% set stats = [
            ['♟', clientRequests|length, 'Clients Actifs', 'bg-emerald-100 text-emerald-700', path('app_coach_space_clients')],
            ['!', pendingCount, "Demandes d'inscription", 'bg-amber-100 text-amber-700', path('app_coach_requests_index')],
            ['!', feedbackCount, 'Feedbacks réalisés', 'bg-orange-100 text-orange-700', path('app_coach_space_feedback')],
            ['↗', clientRequests|filter(item => item.user.journalEntries|length > 1)|length, 'Suivis avec historique', 'bg-indigo-100 text-indigo-700', path('app_coach_space_clients', {filter:'history'})]
        ] %}
        {% for stat in stats %}<a href="{{ stat[4] }}" class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-3 shadow-sm transition hover:border-emerald-300 hover:shadow focus:outline-none focus:ring-2 focus:ring-emerald-500 {{ (filter == 'history' and loop.last) or (filter == 'active' and loop.first) ? 'ring-1 ring-emerald-200' : '' }}"><span class="flex size-9 shrink-0 items-center justify-center rounded-full text-sm font-black {{ stat[3] }}">{{ stat[0] }}</span><div><span class="block text-[0.6rem] font-bold text-slate-600">{{ stat[2] }}</span><strong class="text-lg leading-none">{{ stat[1] }}</strong></div></a>{% endfor %}
    </section>

    <section class="mt-5 grid gap-3 md:grid-cols-2" aria-label="{{ filter == 'history' ? 'Clients avec historique' : 'Clients actifs' }}">
        {% for item in displayedClientRequests %}{% set client = item.user %}{% set entries = client.journalEntries %}{% set latest = entries|last %}{% set previous = entries|length > 1 ? entries|slice(-2,1)|first : null %}{% set goal = client.goal %}
        {% set initial = goal ? goal.initialWeight + 0 : 0 %}{% set target = goal ? goal.targetWeight + 0 : 0 %}{% set current = latest and latest.weight ? latest.weight + 0 : initial %}{% set distance = (initial - target)|abs %}{% set progress = distance > 0 ? min(100,max(0,((initial-current)|abs / distance * 100)|round)) : 0 %}
        <a href="{{ path('app_coach_space_client_show',{id:client.id}) }}" class="block rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-emerald-300">
            <div class="flex items-start justify-between"><div><h2 class="text-sm font-medium">{{ client.name }}</h2><span class="mt-1 inline-flex rounded bg-rose-50 px-1.5 py-0.5 text-[0.5rem] font-black uppercase text-rose-600">En attente</span></div><span class="text-sm font-black {{ previous and latest.weight < previous.weight ? 'text-emerald-600' : 'text-amber-600' }}">{{ previous and latest.weight < previous.weight ? '↗' : '→' }}</span></div>
            <div class="mt-4 grid grid-cols-2 gap-3 text-[0.6rem]"><div><span class="font-bold">Dernière pesée</span><p class="mt-1 text-slate-500">{{ latest ? latest.date|date('d M.') : '—' }} · {{ latest and latest.weight ? latest.weight|number_format(1,',',' ') ~ 'kg' : 'Non renseigné' }}</p></div><div><span class="font-bold">IMC actuel</span><p class="mt-1 text-slate-500">{{ latest and latest.bmi ? latest.bmi|number_format(1,',',' ') : '—' }}{% if previous and previous.bmi and latest.bmi %} ({{ (latest.bmi-previous.bmi)|number_format(1,',',' ') }}){% endif %}</p></div></div>
            <div class="mt-4 h-1 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-emerald-600" style="width:{{ progress }}%"></div></div><div class="mt-1 flex justify-between gap-2 text-[0.5rem] font-black uppercase"><span class="truncate">Objectif: {{ goal ? goal.targetWeight|number_format(0,',',' ') ~ ' kg' : 'non renseigné' }}</span><span>Progrès {{ progress }}%</span></div>
        </a>
        {% else %}<div class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center md:col-span-2"><p class="text-sm font-bold">{{ filter == 'history' ? 'Aucun client avec un historique suffisant' : 'Aucun client actif' }}</p>{% if filter == 'history' %}<a href="{{ path('app_coach_space_clients') }}" class="mt-3 inline-block text-xs font-bold text-emerald-700">Voir tous les clients</a>{% else %}<a href="{{ path('app_coach_requests_index') }}" class="mt-3 inline-block text-xs font-bold text-emerald-700">Consulter les demandes</a>{% endif %}</div>{% endfor %}
    </section>
</main>{% include 'components/_coach_navigation.html.twig' with {active:'clients'} %}</div>
{% endblock %}
