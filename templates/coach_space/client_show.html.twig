{% extends 'base.html.twig' %}{% block title %}Suivi de {{ client.name }} | FitProgress{% endblock %}{% block body %}<div class="fit-page min-h-screen font-sans text-[#1A2B48]">{% include 'components/_app_header.html.twig' %}<main class="mx-auto max-w-4xl px-4 pb-28 pt-6"><a href="{{ path('app_coach_space_clients') }}" class="text-sm font-bold text-slate-600">← Mes clients</a>{% for message in app.flashes('success') %}<p class="mt-4 rounded-xl bg-emerald-50 p-3 text-sm font-bold text-emerald-700">{{ message }}</p>{% endfor %}<section class="mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex items-center gap-4"><span class="flex size-16 items-center justify-center rounded-full bg-emerald-100 text-lg font-black text-emerald-800">{{ client.name|split(' ')|map(p=>p|first)|join|upper|slice(0,2) }}</span><div><h1 class="text-xl font-black">{{ client.name }}</h1><p class="mt-1 text-[10px] text-slate-400">{{ client.proxyEmail }}</p></div></div>{% if client.goal %}<div class="mt-5 grid grid-cols-3 gap-2 text-center"><div class="rounded-xl bg-slate-50 p-3"><strong>{{ client.goal.initialWeight|number_format(1,',',' ') }}</strong><span class="block text-[9px]">Poids initial</span></div><div class="rounded-xl bg-slate-50 p-3"><strong>{{ entries|first and (entries|first).weight ? (entries|first).weight|number_format(1,',',' ') : '—' }}</strong><span class="block text-[9px]">Poids actuel</span></div><div class="rounded-xl bg-slate-50 p-3"><strong>{{ client.goal.targetWeight|number_format(1,',',' ') }}</strong><span class="block text-[9px]">Objectif</span></div></div>{% endif %}</section>
<div class="mt-5 grid gap-5 lg:grid-cols-2"><section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-black">Historique du client</h2><div class="mt-4 grid max-h-[32rem] gap-3 overflow-y-auto">{% for entry in entries %}<a href="{{ path('app_coach_space_client_journal_show',{clientId:client.id,entryId:entry.id}) }}" class="block rounded-xl bg-slate-50 p-4 transition hover:bg-emerald-50"><div class="flex justify-between"><strong class="text-sm">{{ entry.date|date('d/m/Y') }}</strong>{% if entry.weight %}<span class="text-sm font-black text-emerald-700">{{ entry.weight|number_format(1,',',' ') }} kg</span>{% endif %}</div><div class="mt-2 flex flex-wrap gap-3 text-[10px] text-slate-500">{% if entry.bmi %}<span>IMC {{ entry.bmi }}</span>{% endif %}{% if entry.steps %}<span>{{ entry.steps }} pas</span>{% endif %}{% if entry.sleepHours %}<span>{{ entry.sleepHours }} h sommeil</span>{% endif %}</div>{% if entry.notes %}<p class="mt-2 text-xs italic text-slate-600">{{ entry.notes }}</p>{% endif %}</a>{% else %}<p class="text-sm text-slate-500">Aucune donnée de journal.</p>{% endfor %}</div></section>
<div><section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-black">Ajouter un commentaire</h2>{{ form_start(feedbackForm,{attr:{class:'mt-4 grid gap-3'}}) }}{{ form_widget(feedbackForm.title,{attr:{class:'w-full rounded-xl border border-slate-300 p-3 text-sm',placeholder:'Objet du suivi'}}) }}{{ form_widget(feedbackForm.content,{attr:{class:'w-full rounded-xl border border-slate-300 p-3 text-sm',rows:5,placeholder:'Conseils, progression, points d’attention…'}}) }}<div class="text-xs text-rose-600">{{ form_errors(feedbackForm) }}</div><button class="rounded-xl bg-emerald-500 px-4 py-3 text-sm font-bold text-white">Publier le suivi</button>{{ form_end(feedbackForm) }}</section><section class="mt-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-black">Commentaires précédents</h2><div class="mt-4 grid gap-3">{% for feedback in feedbacks %}<article class="border-l-2 border-indigo-400 pl-3"><div class="flex justify-between gap-2"><strong class="text-xs">{{ feedback.title }}</strong><time class="text-[9px] text-slate-400">{{ feedback.createdAt|date('d/m/Y') }}</time></div><p class="mt-1 text-xs leading-5 text-slate-600">{{ feedback.content }}</p></article>{% else %}<p class="text-xs text-slate-500">Aucun commentaire pour le moment.</p>{% endfor %}</div></section></div></div></main>{% include 'components/_coach_navigation.html.twig' with {active:'clients'} %}</div>{% endblock %}
