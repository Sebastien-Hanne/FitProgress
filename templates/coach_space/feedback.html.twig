{% extends 'base.html.twig' %}{% block title %}Feedback clients | FitProgress{% endblock %}{% block body %}<div class="fit-page min-h-screen font-sans text-[#1A2B48]">{% include 'components/_app_header.html.twig' %}<main class="mx-auto max-w-3xl px-4 pb-28 pt-7"><p class="text-xs font-extrabold uppercase tracking-[.16em] text-emerald-600">Suivi</p><h1 class="mt-1 text-2xl font-black">Feedback clients</h1><p class="mt-2 text-sm text-slate-500">Sélectionnez un client pour consulter ou ajouter un commentaire de suivi.</p><section class="mt-6 grid gap-3">{% for item in clientRequests %}<a href="{{ path('app_coach_space_client_show',{id:item.user.id}) }}" class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><strong>{{ item.user.name }}</strong><span class="text-emerald-600">Commenter →</span></a>{% else %}<p class="rounded-2xl border border-dashed bg-white p-10 text-center text-sm text-slate-500">Aucun client actif.</p>{% endfor %}</section></main>{% include 'components/_coach_navigation.html.twig' with {active:'feedback'} %}</div>{% endblock %}
