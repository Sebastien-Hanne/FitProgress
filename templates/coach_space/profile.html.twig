{% extends 'base.html.twig' %}
{% block title %}Profil coach | FitProgress{% endblock %}
{% block body %}
<div class="fit-page min-h-screen font-sans text-[#1A2B48]">{% include 'components/_app_header.html.twig' %}
<main class="mx-auto max-w-xl px-3 pb-28 pt-5 sm:px-6">
    <section class="text-center"><h1 class="text-xl font-black">Cap sur le changement</h1><p class="mx-auto mt-5 max-w-sm text-xs leading-5 text-slate-600">Coach sportif spécialisé en perte de poids et remise en forme. Mon objectif est de vous accompagner avec un suivi personnalisé, adapté à votre rythme et à vos ambitions.</p></section>
    {% for message in app.flashes('success') %}<p class="mt-4 rounded-xl bg-emerald-50 p-3 text-sm font-bold text-emerald-700">{{ message }}</p>{% endfor %}
    <section class="relative mt-6 rounded-xl border border-slate-300 bg-white p-5 text-center shadow-sm">
        <a href="{{ path('app_profile_account', {edit: 'identity'}) }}" class="absolute right-4 top-4 flex size-8 items-center justify-center rounded-full border border-slate-200 bg-white text-sm text-emerald-700 shadow-sm transition hover:border-emerald-500 hover:bg-emerald-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500" aria-label="Modifier mon nom ou ma photo" title="Modifier mon nom ou ma photo">✎</a>
        <div class="mx-auto flex size-20 items-center justify-center overflow-hidden rounded-full bg-emerald-100 text-xl font-black text-emerald-800">{% if app.user.photo %}<img src="{{ asset(app.user.photo) }}" alt="Photo de {{ app.user.name }}" class="size-full object-cover">{% else %}{{ app.user.name|split(' ')|map(p => p|first)|join|upper|slice(0,2) }}{% endif %}</div><h2 class="mt-4 text-lg font-black">{{ app.user.name }}</h2><p class="mt-1 text-[9px] font-bold uppercase tracking-wider text-slate-500">Coach professionnel</p>
    </section>

    {{ form_start(profileForm, {attr: {class: 'mt-5 grid gap-5'}}) }}
    <section class="rounded-xl border border-slate-300 bg-white p-5 shadow-sm"><h2 class="text-sm font-black">Bio Professionnelle</h2><div class="mt-4">{{ form_widget(profileForm.bio, {attr:{class:'min-h-32 w-full resize-none rounded-lg border border-slate-300 bg-[#f3f6ff] p-3 text-xs leading-5', oninput:"this.nextElementSibling.textContent = this.value.length + ' / 500 caractères'"}}) }}<p class="mt-1 text-right text-[9px] text-slate-500">{{ profile.bio|default('')|length }} / 500 caractères</p>{{ form_errors(profileForm.bio) }}</div><button class="mt-3 w-full rounded-lg bg-emerald-500 px-4 py-2.5 text-xs font-bold text-white">Enregistrer</button></section>

    <section class="rounded-xl border border-slate-300 bg-white p-5 shadow-sm"><h2 class="text-lg font-black">Coaching Style</h2><p class="mt-2 text-[10px] leading-4 text-slate-500">Choisissez votre style de coaching principal et votre approche d’accompagnement.</p><div class="mt-4 grid gap-3">
        {% set styleInfo = {'analytical':['Analytique','Basé sur les données, méthodique et précis.'],'motivational':['Motivation','Dynamique, motivant et enthousiaste.'],'structured':['Structuré','Méthodique, axé sur la routine et discipliné.']} %}
        {% for choice in profileForm.coachingStyle %}
            {% set info = styleInfo[choice.vars.value] %}
            <label class="block cursor-pointer">
                {{ form_widget(choice, {attr:{class:'peer sr-only'}}) }}
                <span class="group flex flex-col items-center rounded-lg border border-slate-300 p-4 text-center transition hover:border-emerald-300 hover:bg-emerald-50/40 peer-checked:border-emerald-500 peer-checked:bg-emerald-50 peer-checked:ring-2 peer-checked:ring-emerald-100">
                    <span class="flex size-10 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 transition group-hover:bg-emerald-100" aria-hidden="true">
                        {% if choice.vars.value == 'analytical' %}
                            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V9m5 10V5m5 14v-7m5 7V8M2.5 19.5h19"/></svg>
                        {% elseif choice.vars.value == 'motivational' %}
                            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M13 2 5 14h6l-1 8 9-13h-6V2z"/></svg>
                        {% else %}
                            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/></svg>
                        {% endif %}
                    </span>
                    <strong class="mt-2 text-xs">{{ info[0] }}</strong>
                    <small class="mt-1 text-[8px] text-slate-500">{{ info[1] }}</small>
                </span>
            </label>
        {% endfor %}
    </div></section>

    <section class="rounded-xl border border-slate-300 bg-white p-5 shadow-sm"><h2 class="text-sm font-black">Spécialités &amp; expérience</h2><div class="mt-4 grid gap-4"><div>{{ form_label(profileForm.specialties, null, {label_attr:{class:'mb-2 block text-xs font-bold'}}) }}{{ form_widget(profileForm.specialties,{attr:{class:'w-full rounded-lg border border-slate-300 bg-slate-50 p-3 text-xs'}}) }}<p class="mt-1 text-[9px] text-slate-400">Séparez les spécialités par des virgules.</p></div><div>{{ form_label(profileForm.experienceYears,null,{label_attr:{class:'mb-2 block text-xs font-bold'}}) }}{{ form_widget(profileForm.experienceYears,{attr:{class:'w-full rounded-lg border border-slate-300 p-3 text-xs'}}) }}</div></div></section>

    <section class="rounded-xl border border-slate-300 bg-white p-5 shadow-sm"><h2 class="text-lg font-black">Capacité d’accueil</h2><p class="mt-2 text-[10px] leading-4 text-slate-500">Combien de clients pouvez-vous accompagner simultanément ?</p><div class="mt-5 flex items-center gap-4">{{ form_widget(profileForm.maxCapacity,{attr:{class:'h-2 flex-1 cursor-pointer accent-emerald-500',oninput:"document.getElementById('capacity-value').textContent=this.value"}}) }}<span id="capacity-value" class="flex size-11 items-center justify-center rounded-full bg-emerald-500 text-lg font-black text-white">{{ profile.maxCapacity }}</span></div><div class="mt-2 flex justify-between text-[8px] text-slate-500"><span>Focus (1)</span><span>Étendu (30+)</span></div><label class="mt-5 flex items-center justify-between rounded-xl bg-emerald-50 p-3 text-xs font-bold"><span>Disponible pour de nouveaux clients</span>{{ form_widget(profileForm.isAvailable,{attr:{class:'size-5 accent-emerald-500'}}) }}</label><p class="mt-3 text-center text-[9px] text-slate-500">{{ activeCount }} client{{ activeCount != 1 ? 's' }} actif{{ activeCount != 1 ? 's' }} sur {{ profile.maxCapacity }}</p></section>
    <button class="rounded-xl bg-emerald-600 px-5 py-3 text-sm font-black text-white">Enregistrer toutes les modifications</button>{{ form_end(profileForm) }}
    <section class="mt-5 overflow-hidden rounded-xl border border-slate-300 bg-white shadow-sm">
        <h2 class="px-5 py-4 text-sm font-black">Paramètres &amp; Préférences</h2>
        {% set coachSettings = [
            ['account', 'Paramètres du compte', 'app_profile_account'],
            ['privacy', 'Confidentialité', 'app_profile_privacy'],
            ['accessibility', 'Accessibilité', 'app_accessibility']
        ] %}
        {% for setting in coachSettings %}
            <a href="{{ path(setting[2]) }}" class="group flex items-center gap-3 border-t border-slate-100 px-5 py-4 text-xs font-bold transition hover:bg-slate-50">
                <span class="flex size-8 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 transition group-hover:bg-emerald-100" aria-hidden="true">
                    {% if setting[0] == 'account' %}
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M6.5 20a5.5 5.5 0 0111 0M19 8.5v-3m-1.5 1.5h3"/></svg>
                    {% elseif setting[0] == 'privacy' %}
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v5c0 4.7-2.9 8.4-7 10-4.1-1.6-7-5.3-7-10V6l7-3z"/><path stroke-linecap="round" d="M9 12l2 2 4-4"/></svg>
                    {% else %}
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="4.5" r="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M12 8v5m0 0l-4 7m4-7 4 7"/></svg>
                    {% endif %}
                </span>
                <span class="flex-1">{{ setting[1] }}</span>
                <svg class="size-4 text-slate-300 transition group-hover:translate-x-0.5 group-hover:text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg>
            </a>
        {% endfor %}
    </section>
    <div class="mt-5 grid gap-3">
        <a href="{{ path('app_logout') }}" class="flex items-center justify-center gap-2 rounded-lg border border-red-500 px-4 py-3 text-xs font-bold text-red-600 transition hover:bg-red-50">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 5H5v14h5m4-4 4-3-4-3m4 3H9"/></svg>
            <span>Déconnexion</span>
        </a>
        <a href="{{ path('app_profile_privacy') }}" class="flex items-center justify-center gap-2 rounded-lg bg-red-700 px-4 py-3 text-xs font-bold text-white transition hover:bg-red-800">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7m4 4v5m4-5v5"/></svg>
            <span>Supprimer le compte</span>
        </a>
    </div>
</main>{% include 'components/_coach_navigation.html.twig' with {active:'profile'} %}</div>
{% endblock %}
