{% extends 'base.html.twig' %}
{% block title %}{{ pageTitle }} | FitProgress{% endblock %}
{% block body %}
<div class="fit-page min-h-screen font-sans text-[#1A2B48]">{% include 'components/_app_header.html.twig' %}
<main class="mx-auto max-w-xl px-4 pb-28 pt-7"><a href="{{ path('app_coach_space_schedule') }}" class="text-xs font-bold text-emerald-700">← Retour au planning</a><h1 class="mt-4 text-2xl font-black">{{ pageTitle }}</h1>
{{ form_start(sessionForm, {attr: {class: 'mt-6 grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm'}}) }}
{% for field in sessionForm %}{% if field.vars.name != '_token' %}<div>{{ form_label(field, null, {label_attr: {class: 'mb-1.5 block text-xs font-bold'}}) }}{{ form_widget(field, {attr: {class: 'w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-emerald-500'}}) }}{{ form_errors(field) }}</div>{% endif %}{% endfor %}
{{ form_rest(sessionForm) }}<button class="mt-2 rounded-xl bg-emerald-500 px-4 py-3 text-sm font-bold text-white">{{ submitLabel }}</button>{{ form_end(sessionForm, {render_rest: false}) }}
</main>{% include 'components/_coach_navigation.html.twig' with {active:'schedule'} %}</div>
{% endblock %}
