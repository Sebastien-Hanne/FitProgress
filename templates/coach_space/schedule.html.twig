{% extends 'base.html.twig' %}{% block title %}Schedule | FitProgress{% endblock %}{% block body %}<div class="fit-page min-h-screen font-sans text-[#1A2B48]">{% include 'components/_app_header.html.twig' %}<main class="mx-auto max-w-3xl px-4 pb-28 pt-7"><p class="text-xs font-extrabold uppercase tracking-[.16em] text-emerald-600">Planning</p><h1 class="mt-1 text-2xl font-black">Schedule</h1><section class="mt-6 grid gap-3">{% for session in sessions %}<article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex justify-between gap-3"><div><h2 class="font-black">{{ session.title }}</h2><p class="mt-1 text-xs text-slate-500">{{ session.user.name }}</p></div><time class="text-xs font-bold text-emerald-700">{{ session.startAt|date('d/m · H:i') }}</time></div></article>{% else %}<p class="rounded-2xl border border-dashed bg-white p-10 text-center text-sm text-slate-500">Aucune séance planifiée.</p>{% endfor %}</section></main>{% include 'components/_coach_navigation.html.twig' with {active:'schedule'} %}</div>{% endblock %}
