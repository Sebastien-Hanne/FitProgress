{% extends 'base.html.twig' %}
{% block title %}Planning de coaching | FitProgress{% endblock %}
{% block body %}
<div class="fit-page min-h-screen font-sans text-[#1A2B48]">
{% include 'components/_app_header.html.twig' %}
<main class="mx-auto max-w-3xl px-4 pb-28 pt-7">
    <div class="flex items-start justify-between gap-4">
        <div><p class="text-xs font-extrabold uppercase tracking-[.16em] text-emerald-600">Organisation</p><h1 class="mt-1 text-2xl font-black">Planning de Coaching</h1><p class="mt-2 text-sm text-slate-500">Gérez les séances d’entraînement et les suivis de vos clients.</p></div>
        <a href="{{ path('app_coach_space_schedule_new') }}" class="flex size-11 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-2xl font-bold text-white shadow-sm transition hover:bg-emerald-600" aria-label="Planifier une séance">+</a>
    </div>
    {% for message in app.flashes('success') %}<p class="mt-5 rounded-xl bg-emerald-50 p-3 text-sm font-bold text-emerald-800">{{ message }}</p>{% endfor %}
    <section class="mt-7 grid gap-3" aria-label="Séances de coaching">
    {% for session in sessions %}
        {% set statusLabel = session.status.value == 'scheduled' ? 'Planifiée' : (session.status.value == 'completed' ? 'Terminée' : 'Annulée') %}
        {% set statusClass = session.status.value == 'scheduled' ? 'bg-blue-50 text-blue-700' : (session.status.value == 'completed' ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700') %}
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm {{ session.status.value == 'cancelled' ? 'opacity-70' : '' }}">
            <div class="flex items-start gap-4"><span class="flex size-11 shrink-0 items-center justify-center overflow-hidden rounded-full bg-slate-100 text-xs font-black">{% if session.user.photo %}<img src="{{ asset(session.user.photo) }}" alt="Photo de {{ session.user.name }}" class="size-full object-cover">{% else %}{{ session.user.name|split(' ')|map(part => part|first|upper)|join|slice(0, 2) }}{% endif %}</span><div class="min-w-0 flex-1"><div class="flex flex-wrap items-start justify-between gap-2"><div><h2 class="font-black">{{ session.user.name }}</h2><p class="text-xs font-bold text-slate-600">{{ session.title }}</p></div><span class="rounded-full px-2.5 py-1 text-[10px] font-bold {{ statusClass }}">{{ statusLabel }}</span></div><div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-slate-500"><time datetime="{{ session.startAt|date('c') }}">◷ {{ session.startAt|date('d/m/Y à H:i') }}</time><span>Durée : {{ session.durationMinutes }} min</span>{% if session.location %}<span>⌖ {{ session.location }}</span>{% endif %}</div>{% if session.notes %}<p class="mt-2 text-xs text-slate-500">{{ session.notes }}</p>{% endif %}</div></div>
            {% if session.status.value == 'scheduled' %}<div class="mt-4 flex flex-wrap justify-end gap-2"><a href="{{ path('app_coach_space_schedule_edit', {id: session.id}) }}" class="rounded-xl border border-slate-300 px-3 py-2 text-xs font-bold">Modifier</a><form method="post" action="{{ path('app_coach_space_schedule_complete', {id: session.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('complete_session_' ~ session.id) }}"><button class="rounded-xl bg-emerald-500 px-3 py-2 text-xs font-bold text-white">Marquer terminée</button></form><form method="post" action="{{ path('app_coach_space_schedule_cancel', {id: session.id}) }}" onsubmit="return confirm('Annuler cette séance ?')"><input type="hidden" name="_token" value="{{ csrf_token('cancel_session_' ~ session.id) }}"><button class="rounded-xl border border-rose-200 px-3 py-2 text-xs font-bold text-rose-700">Annuler</button></form></div>{% endif %}
        </article>
    {% else %}<div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center"><p class="text-sm font-bold">Aucune séance planifiée.</p><a href="{{ path('app_coach_space_schedule_new') }}" class="mt-4 inline-block rounded-xl bg-emerald-500 px-4 py-3 text-xs font-bold text-white">Planifier la première séance</a></div>{% endfor %}
    </section>
</main>
{% include 'components/_coach_navigation.html.twig' with {active:'schedule'} %}
</div>
{% endblock %}
