<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}FitProgress — Suivez vos progrès{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}FitProgress vous aide à suivre votre poids, vos habitudes et vos objectifs avec un accompagnement personnalisé.{% endblock %}">
        <meta name="theme-color" content="#00b887">
        <link rel="icon" type="image/png" href="{{ asset('img/logo-small.png') }}">
        {% block stylesheets %}
        {% endblock %}
        <style>
            :root {
                --fit-navy: #1a2b48;
                --fit-action-blue: #1769aa;
                --fit-feedback: #494be8;
                --fit-success: #00b887;
                --fit-success-dark: #008567;
                --fit-page: #f7f9fc;
                --fit-alert-bg: #ffe3e1;
                --fit-alert-text: #dc5d58;
            }
            body { color: var(--fit-navy); }
            .app-header {
                width: 100vw;
                margin-left: calc(50% - 50vw);
            }
            .fit-text { color: var(--fit-navy) !important; }
            .fit-page { background-color: var(--fit-page) !important; }
            .fit-success-bg { background-color: var(--fit-success) !important; }
            .fit-success-text { color: var(--fit-success-dark) !important; }
            .fit-feedback-card { background-color: var(--fit-feedback) !important; }
            .fit-alert {
                border-color: #ffc9c5 !important;
                background-color: var(--fit-alert-bg) !important;
                color: var(--fit-alert-text) !important;
            }
            .fit-action-button {
                display: flex !important;
                background-color: var(--fit-action-blue) !important;
                color: #fff !important;
            }
            .fit-action-button:hover { background-color: #125a94 !important; }
            .fit-action-button:focus-visible {
                outline: 3px solid rgba(0, 184, 135, .45) !important;
                outline-offset: 2px;
            }
            .fit-period-active {
                background-color: var(--fit-success) !important;
                color: #fff !important;
                box-shadow: 0 2px 8px rgba(0, 184, 135, .22);
            }
            .app-navigation {
                display: grid !important;
                grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
                align-items: center;
                min-height: 4.5rem;
            }
            .app-nav-item {
                display: flex !important;
                min-width: 0;
                flex-direction: column !important;
                align-items: center !important;
                justify-content: center !important;
                gap: .2rem;
                padding: .55rem .2rem;
                border: 0;
                border-radius: 9999px;
                background: transparent;
                color: #1a2b48;
                text-decoration: none;
            }
            .app-nav-item.is-active {
                background-color: var(--fit-success) !important;
                color: #fff !important;
                box-shadow: 0 4px 12px rgba(0, 184, 135, .24);
            }
            .app-nav-icon {
                display: flex !important;
                width: 1.65rem;
                height: 1.65rem;
                align-items: center !important;
                justify-content: center !important;
            }
            .app-nav-label {
                display: block;
                font-size: .48rem;
                font-weight: 800;
                line-height: 1;
                text-transform: uppercase;
                white-space: nowrap;
            }
            .journal-shell {
                width: 100%;
                max-width: 28rem;
                min-height: 100vh;
                margin: 0 auto;
                background-color: var(--fit-page);
                box-shadow: 0 0 28px rgba(15, 23, 42, .12);
            }
            .journal-card {
                border: 1px solid #d9dee7;
                border-radius: .75rem;
                background: #fff;
                box-shadow: 0 1px 2px rgba(15, 23, 42, .06);
            }
            .journal-day-strip {
                display: grid;
                width: 100%;
                grid-auto-columns: 4.5rem;
                grid-auto-flow: column;
                gap: .55rem;
                overflow-x: auto;
                padding: .3rem max(0rem, calc(50% - 2.25rem)) .65rem;
                scroll-padding-inline: max(0rem, calc(50% - 2.25rem));
                scroll-snap-type: x mandatory;
                scrollbar-width: thin;
                scrollbar-color: #cbd5e1 transparent;
            }
            .journal-day {
                display: flex;
                min-height: 5rem;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                border: 1px solid #e2e8f0;
                border-radius: 1rem;
                background: #fff;
                color: #475569;
                font-size: .7rem;
                font-weight: 700;
                scroll-snap-align: center;
                box-shadow: 0 2px 8px rgba(15, 23, 42, .05);
            }
            .journal-day strong { font-size: 1.3rem; }
            .journal-day small {
                margin-top: .15rem;
                font-size: .48rem;
                font-weight: 800;
                text-transform: uppercase;
            }
            .journal-day.is-today {
                border-color: #00b887;
                outline: 2px solid rgba(0, 184, 135, .16);
                background: #00b887;
                color: #fff;
                box-shadow: 0 8px 20px rgba(0, 184, 135, .24);
            }
            .journal-choice-grid {
                display: grid;
                grid-template-columns: repeat(5, minmax(0, 1fr));
                gap: .25rem;
            }
            .journal-choice-grid input {
                position: absolute;
                width: 1px;
                height: 1px;
                opacity: 0;
            }
            .journal-choice-grid label {
                display: flex;
                min-width: 0;
                cursor: pointer;
                flex-direction: column;
                align-items: center;
                gap: .3rem;
                border-radius: .7rem;
                padding: .45rem .1rem;
                color: #94a3b8;
                font-size: .6rem;
                font-weight: 700;
                text-align: center;
            }
            .journal-choice-grid label::before {
                content: '●';
                display: flex;
                width: 2.35rem;
                height: 2.35rem;
                align-items: center;
                justify-content: center;
                border-radius: 999px;
                background: #f8d9d9;
                color: #fff;
                font-size: 1.35rem;
            }
            .journal-mood-grid > div:nth-child(1) label::before { content: '😣'; background: #f8d1d1; }
            .journal-mood-grid > div:nth-child(2) label::before { content: '☹'; background: #f5d7c6; }
            .journal-mood-grid > div:nth-child(3) label::before { content: '😐'; background: #f8e7c7; }
            .journal-mood-grid > div:nth-child(4) label::before { content: '🙂'; background: #f7c86b; }
            .journal-mood-grid > div:nth-child(5) label::before { content: '😄'; background: #bcebdc; }
            .journal-mood-grid label::before { display: none; }
            .journal-mood-icon {
                display: flex;
                width: 2.75rem;
                height: 2.75rem;
                align-items: center;
                justify-content: center;
                border-radius: 999px;
                background: #f8e7c7;
                font-size: 1.7rem;
                line-height: 1;
            }
            .journal-mood-grid input:checked + label .journal-mood-icon {
                background: #bcebdc;
                box-shadow: 0 0 0 3px rgba(0, 184, 135, .18);
            }
            .journal-choice-grid input:checked + label {
                background: #e8f8f3;
                color: #008567;
            }
            .journal-choice-grid input:checked + label::before { background: #00b887; }
            .journal-energy-grid label::before {
                content: '';
                width: .9rem;
                border-radius: .3rem .3rem 0 0;
                background: #cfe8e2;
            }
            .journal-energy-grid > div:nth-of-type(1) label::before { height: 1rem; }
            .journal-energy-grid > div:nth-of-type(2) label::before { height: 1.5rem; }
            .journal-energy-grid > div:nth-of-type(3) label::before { height: 2rem; }
            .journal-energy-grid > div:nth-of-type(4) label::before { height: 2.5rem; }
            .journal-energy-grid > div:nth-of-type(5) label::before {
                width: 1.05rem;
                height: 4rem;
            }
            .journal-energy-grid input:checked + label::before { background: #00b887; }
            .journal-energy-grid {
                max-width: 12rem;
                margin-right: auto;
                margin-left: auto;
                align-items: end;
            }
            .journal-energy-grid label {
                justify-content: end;
                min-height: 5rem;
                font-size: 0;
            }
            .journal-sleep-quality {
                display: flex;
                gap: .15rem;
            }
            .journal-sleep-quality input {
                position: absolute;
                opacity: 0;
            }
            .journal-sleep-quality label {
                cursor: pointer;
                font-size: 0;
            }
            .journal-sleep-quality label::before {
                content: '★';
                color: #cbd5e1;
                font-size: 1.25rem;
            }
            .journal-sleep-quality input:checked + label::before { color: #4b4ce1; }
            .journal-sleep-quality label.is-filled::before { color: #4b4ce1; }
            .journal-water-input,
            .journal-weight-input {
                width: 100%;
                border: 0 !important;
                background: transparent !important;
                text-align: center;
                outline: 0 !important;
                appearance: textfield;
            }
            .journal-water-input::-webkit-inner-spin-button,
            .journal-water-input::-webkit-outer-spin-button,
            .journal-weight-input::-webkit-inner-spin-button,
            .journal-weight-input::-webkit-outer-spin-button { appearance: none; margin: 0; }
            .journal-water-input {
                color: #4b4ce1;
                font-size: 2rem !important;
                font-weight: 900;
            }
            .journal-hydration-layout {
                display: grid !important;
                grid-template-columns: minmax(0, 1fr) 2.25rem 5.5rem 2.25rem;
                align-items: center;
                gap: .35rem;
            }
            .journal-round-button {
                display: flex !important;
                width: 2.25rem;
                height: 2.25rem;
                align-items: center !important;
                justify-content: center !important;
                border: 0;
                border-radius: 999px;
                font-size: 1.25rem;
                font-weight: 900;
            }
            .journal-weight-wheel {
                position: relative;
                height: 4.5rem;
                cursor: ew-resize;
                touch-action: none;
                user-select: none;
                overflow: hidden;
                border-radius: .75rem;
                background: repeating-linear-gradient(90deg, transparent 0, transparent 10px, #cbd5e1 11px, #cbd5e1 13px);
            }
            .journal-weight-wheel::after {
                content: '';
                position: absolute;
                top: .25rem;
                bottom: .25rem;
                left: 50%;
                width: 3px;
                border-radius: 999px;
                background: #0f172a;
                transform: translateX(-50%);
            }
            .journal-meal-fields {
                display: grid !important;
                grid-template-columns: 1.75rem minmax(0, 1fr) 4.25rem 2rem;
                gap: .5rem !important;
                align-items: center;
            }
            .journal-meal-fields select,
            .journal-meal-fields input {
                min-width: 0;
                width: 100%;
                border: 0 !important;
                background: transparent !important;
                padding: .15rem 0 !important;
                outline: 0 !important;
            }
            .journal-meal-type select {
                width: auto !important;
                max-width: 100%;
                color: #0f172a;
                font-size: .68rem !important;
                font-weight: 800;
            }
            .journal-meal-title input {
                color: #334155;
                font-size: .62rem !important;
                font-weight: 600;
            }
            .journal-meal-calories input {
                color: #0f172a;
                font-size: .7rem !important;
                font-weight: 800;
                text-align: right;
                appearance: textfield;
            }
            .journal-meal-calories-line {
                display: flex;
                align-items: center;
                justify-content: end;
                gap: .2rem;
                white-space: nowrap;
            }
            .journal-meal-calories-line input { width: 2.8rem !important; }
            .journal-meal-icon {
                display: flex;
                width: 1.65rem;
                height: 1.65rem;
                align-items: center;
                justify-content: center;
                border-radius: .45rem;
                background: #eef2ff;
                color: #4b4ce1;
                font-size: 1rem;
            }
            .journal-meal-remove {
                display: flex !important;
                width: 2rem;
                height: 2rem;
                align-items: center !important;
                justify-content: center !important;
                border: 0;
                border-radius: 999px;
                background: #fff1f2;
                color: #e11d48;
                font-size: 1.15rem;
            }
            .journal-meal-remove:hover { background: #ffe4e6; color: #be123c; }
            .journal-activity-input {
                width: 5rem;
                border: 0 !important;
                background: transparent !important;
                color: #008567;
                font-size: 2rem !important;
                font-weight: 900;
                outline: 0 !important;
                appearance: textfield;
            }
            .journal-activity-ring {
                display: flex;
                width: 4.25rem;
                height: 4.25rem;
                align-items: center;
                justify-content: center;
                border-radius: 999px;
                background: conic-gradient(#00b887 var(--activity-progress, 0%), #dff7ef 0);
            }
            .journal-activity-ring::before {
                content: '';
                position: absolute;
                width: 3.25rem;
                height: 3.25rem;
                border-radius: 999px;
                background: #fff;
            }
            .journal-activity-ring span { position: relative; z-index: 1; }
            .journal-notes {
                width: 100%;
                resize: vertical;
                border: 1px solid #d1d5db;
                border-radius: .75rem;
                background: #fff;
                padding: 1rem;
                color: #475569;
                font-size: .8rem;
                line-height: 1.5;
                outline: 0;
            }
            .journal-notes:focus { border-color: #00b887; box-shadow: 0 0 0 3px rgba(0, 184, 135, .12); }
            .journal-weight-input {
                color: #0f172a;
                font-size: 2.25rem !important;
                font-weight: 900;
            }
            .app-navigation.is-compact {
                left: 50% !important;
                width: min(28rem, 100%) !important;
                transform: translateX(-50%) !important;
                border-left: 1px solid #e2e8f0;
                border-right: 1px solid #e2e8f0;
            }
            @media (min-width: 1024px) {
                .dashboard-grid {
                    display: grid !important;
                    grid-template-columns: repeat(12, minmax(0, 1fr)) !important;
                }
                .dashboard-full { grid-column: span 12 / span 12 !important; }
                .dashboard-weight { grid-column: span 5 / span 5 !important; }
                .dashboard-bmi { grid-column: span 7 / span 7 !important; }
                .dashboard-chart { grid-column: span 8 / span 8 !important; }
                .dashboard-feedback { grid-column: span 4 / span 4 !important; }
                .dashboard-actions { grid-column: span 4 / span 4 !important; }
                .dashboard-stat-card { min-height: 12rem; padding: 1.5rem !important; }
                .app-navigation {
                    left: 50% !important;
                    width: min(44rem, calc(100% - 3rem)) !important;
                    transform: translateX(-50%) !important;
                    border-left: 1px solid #e2e8f0;
                    border-right: 1px solid #e2e8f0;
                    border-radius: 1rem 1rem 0 0;
                }
                .app-nav-label { font-size: .58rem; }
                .app-navigation.is-compact {
                    width: min(44rem, calc(100% - 3rem)) !important;
                    border-radius: 1rem 1rem 0 0;
                }
                .journal-shell {
                    max-width: 80rem;
                    box-shadow: none;
                }
                .journal-day-strip {
                    grid-template-columns: repeat(11, minmax(0, 1fr));
                    grid-auto-columns: auto;
                    grid-auto-flow: row;
                    gap: .75rem;
                    overflow: visible;
                    padding: .3rem 0 .75rem;
                }
                .journal-main {
                    padding: 2.5rem !important;
                }
                .journal-form {
                    display: grid !important;
                    grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
                    gap: 1.5rem !important;
                    align-items: start;
                }
                .journal-span-full {
                    grid-column: span 6 / span 6 !important;
                }
                .journal-half { grid-column: span 3 / span 3 !important; }
                .journal-third {
                    grid-column: span 2 / span 2 !important;
                    min-height: 12rem;
                }
                .journal-history-grid {
                    display: grid !important;
                    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
                    gap: 1.5rem !important;
                }
            }
        </style>

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
