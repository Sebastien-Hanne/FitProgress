{% extends 'base.html.twig' %}
{% block title %}Retours du Coach | FitProgress{% endblock %}
{% block body %}
<div class="fit-page min-h-screen bg-[#f7f9fc] font-sans text-[#1A2B48]">
    {% include 'components/_app_header.html.twig' %}
    <main class="mx-auto max-w-2xl px-4 pb-28 pt-7 sm:px-6">
        <h1 class="text-2xl font-black">Retours du Coach</h1>
        <p class="mt-1 text-xs leading-5 text-slate-500">Suivez vos conseils personnalisés pour rester motivé.</p>

        <section class="mt-6 grid gap-4" aria-label="Commentaires de votre coach">
            {% for feedback in feedbacks %}
                {% set coach = feedback.coachProfile.user %}
                <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                    <header class="flex items-start gap-3">
                        <span class="flex size-11 shrink-0 items-center justify-center overflow-hidden rounded-full bg-emerald-100 text-xs font-black text-emerald-800">
                            {% if coach.photo %}<img src="{{ asset(coach.photo) }}" alt="" class="size-full object-cover">{% else %}{{ coach.name|split(' ')|map(part => part|first|upper)|join|slice(0, 2) }}{% endif %}
                        </span>
                        <div class="min-w-0 flex-1"><strong class="block text-sm">{{ coach.name }}</strong><time class="mt-0.5 block text-[9px] font-bold uppercase text-slate-500" datetime="{{ feedback.createdAt|date('c') }}">{{ feedback.createdAt|date('d M Y · H:i') }}</time></div>
                        {% if loop.first %}<span class="rounded-full bg-emerald-100 px-2 py-1 text-[9px] font-black text-emerald-700">Nouveau</span>{% endif %}
                    </header>
                    {% if feedback.title %}<h2 class="mt-4 text-sm font-black">{{ feedback.title }}</h2>{% endif %}
                    <p class="mt-2 text-sm leading-6 text-slate-600">{{ feedback.content }}</p>
                    <a href="{{ path('app_messages_index') }}" class="mt-4 flex w-full items-center justify-center rounded-lg bg-emerald-700 px-4 py-2.5 text-xs font-bold text-white transition hover:bg-emerald-800">Réponse rapide</a>
                </article>
            {% else %}
                <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center"><h2 class="font-black">Aucun retour pour le moment</h2><p class="mt-2 text-sm text-slate-500">Les commentaires de votre coach apparaîtront ici.</p></div>
            {% endfor %}
        </section>

        {% if targetWeight is not null %}
        <section class="mt-7" aria-labelledby="weekly-goal-title">
            <h2 id="weekly-goal-title" class="text-lg font-black">Objectif en cours</h2>
            <div class="mt-3 overflow-hidden rounded-2xl bg-emerald-500 p-5 text-white shadow-lg shadow-emerald-500/20">
                <p class="text-[9px] font-black uppercase tracking-wider text-emerald-50">Prochaine étape</p>
                <strong class="mt-1 block text-xl">Atteindre {{ targetWeight|number_format(1, ',', ' ') }} kg</strong>
                <div class="mt-4 h-2 overflow-hidden rounded-full bg-emerald-700/30"><div class="h-full rounded-full bg-white" style="width: {{ goalProgress }}%"></div></div>
                <p class="mt-2 text-[10px] font-bold">{{ goalProgress }}% accompli</p>
            </div>
        </section>
        {% endif %}
    </main>
    {% include 'components/_app_navigation.html.twig' with {active: 'dashboard'} %}
</div>
{% endblock %}
