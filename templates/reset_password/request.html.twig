{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - FitProgress{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f4f7f9] flex flex-col justify-between font-sans">

    {# --- HEADER TOP BAR --- #}
    <header class="w-full bg-white px-5 py-3 flex items-center justify-between border-b border-slate-100 shadow-sm">
        <div class="flex items-center space-x-3">
            {# Remplace /images/logo.png par le chemin de ton logo si nécessaire #}
            <img src="{{ asset('images/logo.png') }}" alt="Logo" class="w-9 h-9 object-contain" onError="this.style.display='none'">
            <span class="text-xl font-bold text-slate-800 tracking-tight">FitProgress</span>
        </div>
        <div class="flex items-center space-x-3">
            <div class="w-9 h-9 rounded-full overflow-hidden border border-gray-200">
                <img src="https://i.pravatar.cc/100?img=12" alt="Avatar" class="w-full h-full object-cover">
            </div>
            <button type="button" class="text-slate-800 hover:text-slate-600 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                </svg>
            </button>
        </div>
    </header>

    {# --- CONTENU PRINCIPAL --- #}
    <main class="flex-1 flex flex-col items-center justify-center px-4 py-8">
        
        {# Affichage des erreurs / messages Flash #}
        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="w-full max-w-sm mb-4 p-3 bg-red-100 text-red-700 text-sm rounded-xl border border-red-200 text-center" role="alert">
                {{ flash_error }}
            </div>
        {% endfor %}

        {# Icône cadenas / cadenas vert dans le rond vert clair #}
        <div class="w-16 h-16 bg-[#e6f7f3] rounded-2xl flex items-center justify-center mb-5 text-[#10b981]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
        </div>

        {# Titre et Sous-titre #}
        <h1 class="text-2xl font-extrabold text-[#0f172a] text-center mb-2">
            Mot de passe oublié ?
        </h1>
        <p class="text-xs text-slate-500 text-center max-w-xs mb-6 leading-relaxed">
            Entrez votre adresse e-mail pour recevoir un lien de réinitialisation.
        </p>

        {# --- CARTE FORMULAIRE --- #}
        <div class="w-full max-w-sm bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
            {{ form_start(requestForm) }}
                
                <div class="mb-5">
                    <label class="block text-xs font-bold text-slate-700 mb-2">Adresse e-mail</label>
                    
                    <div class="relative flex items-center">
                        {# Icône enveloppe dans le champ d'en-tête #}
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        
                        {{ form_widget(requestForm.email, {
                            'attr': {
                                'class': 'w-full bg-[#f0f4f9] text-slate-800 text-sm rounded-xl pl-11 pr-4 py-3 placeholder-slate-400 border-none focus:outline-none focus:ring-2 focus:ring-[#10b981] transition',
                                'placeholder': 'votre@email.com'
                            }
                        }) }}
                    </div>
                    {{ form_errors(requestForm.email) }}
                </div>

                {# Bouton vert 'Envoyer le lien' #}
                <button type="submit" class="w-full bg-[#10b981] hover:bg-[#0e9f6e] text-white font-semibold py-3 px-4 rounded-xl flex items-center justify-center space-x-2 transition duration-200 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform rotate-45 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                    </svg>
                    <span>Envoyer le lien</span>
                </button>

            {{ form_end(requestForm) }}
        </div>

        {# Lien de retour #}
        <div class="mt-6">
            <a href="{{ path('app_login') }}" class="inline-flex items-center space-x-2 text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour à la connexion</span>
            </a>
        </div>

    </main>

    {# Espacement bas pour centrage parfait #}
    <footer class="py-4"></footer>
</div>
{% endblock %}