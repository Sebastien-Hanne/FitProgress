{% extends 'base.html.twig' %}
{% block title %}Mon coach | FitProgress{% endblock %}
{% block body %}<div class="fit-page min-h-screen font-sans text-[#1A2B48]">{% include 'components/_app_header.html.twig' %}<main class="mx-auto max-w-2xl px-4 pb-28 pt-7 sm:px-6"><p class="text-xs font-extrabold uppercase tracking-[.16em] text-emerald-600">Accompagnement</p><h1 class="mt-1 text-2xl font-black">Mon coach</h1>
{% for type, messages in app.flashes %}{% for message in messages %}<div class="mt-4 rounded-xl px-4 py-3 text-sm font-bold {{ type == 'error' ? 'bg-rose-50 text-rose-700' : 'bg-emerald-50 text-emerald-700' }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}
{% if currentRequest %}{% set coach = currentRequest.coachProfile %}<article class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex items-center gap-4"><div class="size-20 overflow-hidden rounded-2xl">{% include 'coach/_avatar.html.twig' %}</div><div><h2 class="text-xl font-black">{{ coach.user.name }}</h2><span class="mt-2 inline-flex rounded-full px-3 py-1 text-xs font-extrabold {{ currentRequest.status.value == 'approved' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' }}">{{ currentRequest.status.value == 'approved' ? 'Coach actuel' : 'Demande en attente' }}</span></div></div><p class="mt-5 text-sm leading-6 text-slate-600">{% if currentRequest.status.value == 'approved' %}Votre accompagnement est actif. Retrouvez ici les informations de votre coach ou choisissez-en un autre.{% else %}Votre demande a été envoyée le {{ currentRequest.createdAt|date('d/m/Y') }}. Vous serez informé dès que le coach aura répondu.{% endif %}</p><div class="mt-5 flex flex-wrap gap-2"><a href="{{ path('app_coach_show', {id: coach.id}) }}" class="rounded-lg bg-emerald-500 px-4 py-2.5 text-sm font-extrabold text-white">Voir la fiche</a><a href="{{ path('app_coach_index') }}" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-bold">Changer de coach</a>{% if currentRequest.status.value == 'pending' %}<form method="post" action="{{ path('app_coach_cancel', {id: currentRequest.id}) }}" onsubmit="return confirm('Annuler cette demande ?')"><input type="hidden" name="_token" value="{{ csrf_token('cancel_coach_request_' ~ currentRequest.id) }}"><button class="rounded-lg px-4 py-2.5 text-sm font-bold text-rose-600 hover:bg-rose-50">Annuler la demande</button></form>{% endif %}</div></article>
{% else %}<div class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center"><div class="mx-auto flex size-14 items-center justify-center rounded-full bg-emerald-50 text-2xl">⌕</div><h2 class="mt-4 text-lg font-black">Vous n’avez pas encore de coach</h2><p class="mt-2 text-sm text-slate-500">Explorez les profils et trouvez l’accompagnement qui vous correspond.</p><a href="{{ path('app_coach_index') }}" class="mt-5 inline-block rounded-xl bg-emerald-500 px-5 py-3 text-sm font-extrabold text-white">Découvrir les coachs</a></div>{% endif %}</main>{% include 'components/_app_navigation.html.twig' with {active: 'profile'} %}</div>{% endblock %}
