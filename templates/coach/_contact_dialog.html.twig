<div data-controller="coach-contact">
    <button type="button" data-action="coach-contact#open" class="{{ buttonClass|default('rounded-lg border border-slate-400 px-3 py-2.5 text-center text-xs font-bold hover:bg-slate-50') }}">Contacter</button>
    <dialog data-coach-contact-target="dialog" data-action="click->coach-contact#backdrop close->coach-contact#close" class="m-auto w-[calc(100%-2rem)] max-w-md overflow-hidden rounded-2xl border-0 bg-white p-0 text-[#1A2B48] shadow-2xl backdrop:bg-slate-900/55 backdrop:backdrop-blur-[1px]">
        <form method="post" action="{{ path('app_coach_request', {id: coach.id}) }}">
            <header class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
                <h2 class="text-base font-black">Contacter {{ coach.user.name }}</h2>
                <button type="button" data-action="coach-contact#close" class="flex size-8 items-center justify-center rounded-full text-2xl text-slate-500 hover:bg-slate-100" aria-label="Fermer">×</button>
            </header>
            <div class="p-5">
                <input type="hidden" name="_token" value="{{ csrf_token('coach_request_' ~ coach.id) }}">
                <fieldset><legend class="text-xs font-extrabold">Quel est l’objet de votre demande ?</legend><div class="mt-3 flex flex-wrap gap-2">
                    {% for value, label in {'weight_loss': 'Perte de poids', 'muscle_gain': 'Prise de masse', 'fitness': 'Remise en forme', 'other': 'Autre'} %}
                        <label><input class="peer sr-only" type="radio" name="subject" value="{{ value }}" {{ loop.first ? 'required checked' : 'required' }}><span class="inline-flex cursor-pointer rounded-full bg-[#e6eef8] px-3 py-2 text-xs font-bold text-slate-600 transition peer-checked:bg-emerald-500 peer-checked:text-white">{{ label }}</span></label>
                    {% endfor %}
                </div></fieldset>
                <label for="message-{{ coach.id }}" class="mt-5 block text-xs font-extrabold">Votre message <span class="font-normal">(optionnel)</span></label>
                <textarea id="message-{{ coach.id }}" name="message" rows="4" maxlength="1900" placeholder="Expliquez brièvement vos objectifs…" class="mt-2 w-full resize-none rounded-lg border border-slate-300 bg-[#f0f5ff] p-3 text-sm outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100"></textarea>
                {% if currentRequest %}<p class="mt-2 text-xs text-amber-700">Cette demande remplacera votre accompagnement ou demande actuelle.</p>{% endif %}
            </div>
            <footer class="flex items-center justify-end gap-5 border-t border-slate-200 px-5 py-4">
                <button type="button" data-action="coach-contact#close" class="px-2 py-2 text-sm text-slate-600">Annuler</button>
                <button class="rounded-lg bg-emerald-500 px-4 py-3 text-sm font-bold text-white hover:bg-emerald-600">Envoyer la demande</button>
            </footer>
        </form>
    </dialog>
</div>
