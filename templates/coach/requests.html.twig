{% extends 'base.html.twig' %}{% block title %}Demandes de coaching | FitProgress{% endblock %}{% block body %}<div class="fit-page min-h-screen font-sans text-[#1A2B48]">{% include 'components/_app_header.html.twig' %}<main class="mx-auto max-w-3xl px-4 pb-28 pt-7"><p class="text-xs font-extrabold uppercase tracking-[.16em] text-emerald-600">Espace coach</p><h1 class="mt-1 text-2xl font-black">Demandes de coaching</h1><section class="mt-6 grid gap-3">{% for item in requests %}<article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex justify-between gap-3"><div><h2 class="font-black">{{ item.user.name }}</h2><p class="mt-1 text-[10px] text-slate-400">{{ item.user.proxyEmail }} · {{ item.createdAt|date('d/m/Y à H:i') }}</p></div><span class="h-fit rounded-full px-3 py-1 text-[10px] font-bold {{ item.status.value == 'pending' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800' }}">{{ item.status.value == 'pending' ? 'En attente' : (item.status.value == 'approved' ? 'Acceptée' : 'Clôturée') }}</span></div>{% if item.message %}<p class="mt-4 whitespace-pre-line rounded-xl bg-slate-50 p-3 text-sm text-slate-600">{{ item.message }}</p>{% endif %}{% if item.status.value == 'pending' %}<form method="post" action="{{ path('app_coach_requests_accept', {id: item.id}) }}" class="mt-4"><input type="hidden" name="_token" value="{{ csrf_token('accept_coach_request_' ~ item.id) }}"><button class="w-full rounded-xl bg-emerald-500 px-4 py-3 text-sm font-bold text-white">Accepter et ouvrir la messagerie</button></form>{% elseif item.status.value == 'approved' %}<a href="{{ path('app_messages_index') }}" class="mt-4 inline-block text-sm font-bold text-emerald-700">Ouvrir la messagerie →</a>{% endif %}</article>{% else %}<p class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500">Aucune demande reçue.</p>{% endfor %}</section></main>{% include 'components/_app_navigation.html.twig' with {active: 'profile'} %}</div>{% endblock %}
