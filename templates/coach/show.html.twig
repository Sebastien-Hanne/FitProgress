{% extends 'base.html.twig' %}
{% block title %}{{ coach.user.name }} | FitProgress{% endblock %}
{% block body %}
{% set tags = (coach.specialties ?? '')|split(',') %}
{% set acceptedClients = coach.coachRequests|filter(item => item.status.value == 'approved')|length %}
<div class="fit-page min-h-screen font-sans text-[#1A2B48]">
{% include 'components/_app_header.html.twig' %}
<main class="mx-auto max-w-3xl px-3 pb-48 pt-3 sm:px-6 lg:pb-44 lg:pt-8">
<a href="{{ path('app_coach_index') }}" class="mb-3 inline-flex text-xs font-bold text-slate-600">← Tous les coachs</a>
<section class="overflow-hidden rounded-xl border border-slate-300 bg-white shadow-sm" aria-labelledby="coach-name">
<div class="h-28 bg-gradient-to-r from-emerald-500 to-teal-500"></div><div class="relative px-5 pb-5"><div class="absolute -top-12 size-24 overflow-hidden rounded-full border-4 border-white bg-white shadow-md">{% include 'coach/_avatar.html.twig' %}</div><div class="flex min-h-14 justify-end pt-3"><span class="flex size-7 items-center justify-center rounded-full border-2 border-white bg-emerald-600 text-xs text-white" title="Coach certifié">✓</span></div><h1 id="coach-name" class="mt-1 text-xl font-black">{{ coach.user.name }}</h1><p class="mt-1 text-xs text-slate-600">Coach {{ tags|filter(tag => tag|trim)|join(' & ') ?: 'sportif' }}</p><p class="mt-2 text-xs text-slate-600">⌾ {{ coach.location ?: 'Accompagnement en ligne' }}{% if coach.isAvailable %} <span class="text-emerald-600">(Disponible en ligne)</span>{% endif %}</p></div>
</section>
<section class="mt-5 grid grid-cols-2 gap-3" aria-label="Expérience du coach">
{% set stats = [['♣', acceptedClients ~ '+', 'clients coachés'], ['▣', coach.experienceYears ?? 0, 'années d’exp.'], ['♜', coach.certificates|length, 'certifications'], ['♨', tags|filter(tag => tag|trim)|first|default('Sport'), 'spécialité']] %}
{% for stat in stats %}<article class="rounded-xl border border-slate-300 bg-white p-5 text-center shadow-sm"><span class="text-xl text-emerald-700">{{ stat[0] }}</span><strong class="mt-2 block text-sm">{{ stat[1] }}<br>{{ stat[2] }}</strong></article>{% endfor %}
</section>
<section class="mt-5 rounded-xl border border-slate-300 bg-white p-5 shadow-sm" aria-labelledby="about-title"><h2 id="about-title" class="text-sm font-black">À propos</h2><p class="mt-4 whitespace-pre-line text-xs leading-5 text-slate-600">{{ coach.bio ?: 'Passionné par le mouvement et la biomécanique, je vous accompagne vers vos objectifs de transformation physique et de bien-être avec une approche personnalisée et durable.' }}</p><p class="mt-4 text-xs leading-5 text-slate-600">Mon approche est {{ coach.coachingStyle ? coach.coachingStyle.value|replace({'analytical': 'analytique', 'motivational': 'motivante', 'structured': 'structurée'}) : 'progressive' }} : progresser avec constance, sans se blesser. Chaque séance s’adapte à votre niveau, votre rythme et vos contraintes.</p></section>
<section class="mt-5 rounded-xl border border-slate-300 bg-white p-5 shadow-sm" aria-labelledby="method-title"><h2 id="method-title" class="text-sm font-black">Spécialités &amp; Méthode</h2><div class="mt-4 flex flex-wrap gap-2">{% for tag in tags %}{% if tag|trim %}<span class="rounded-full border border-slate-300 bg-[#edf4fb] px-3 py-1.5 text-[10px] font-bold text-slate-600">⌁ {{ tag|trim }}</span>{% endif %}{% endfor %}</div><div class="mt-5 rounded-lg border border-dashed border-slate-300 p-4"><h3 class="text-center text-xs font-bold">Cycle d’entraînement type</h3><div class="mt-5 grid grid-cols-3 text-center text-[9px] text-slate-600">{% for number, item in {1: 'Bilan initial', 2: 'Phase adaptative', 3: 'Progression & surcharge'} %}<div><span class="mx-auto flex size-6 items-center justify-center rounded-full bg-emerald-500 font-black text-white">{{ number }}</span><p class="mt-2 px-1">{{ item }}</p></div>{% endfor %}</div></div></section>
</main>
<div class="fixed inset-x-0 bottom-[4.5rem] z-10 border-t border-slate-200 bg-white/95 px-4 py-3 backdrop-blur"><div class="mx-auto flex max-w-3xl items-center justify-between gap-4"><div><p class="text-[10px] text-slate-500">Prêt à commencer ?</p><strong class="text-xs">{{ coach.user.name }}</strong></div>{% if currentRequest and currentRequest.coachProfile == coach %}<a href="{{ path('app_coach_status') }}" class="rounded-lg bg-emerald-700 px-6 py-3 text-xs font-bold text-white">Voir ma demande</a>{% else %}{% include 'coach/_contact_dialog.html.twig' with {buttonClass: 'rounded-lg bg-emerald-700 px-7 py-3 text-xs font-bold text-white hover:bg-emerald-800'} %}{% endif %}</div></div>
{% include 'components/_app_navigation.html.twig' with {active: 'profile'} %}</div>
{% endblock %}
