{% extends 'base.html.twig' %}

{% block title %}Trouver un coach | FitProgress{% endblock %}

{% block body %}
<div class="fit-page min-h-screen font-sans text-[#1A2B48]">
    {% include 'components/_app_header.html.twig' %}
    <main class="mx-auto max-w-5xl px-4 pb-28 pt-7 sm:px-6 lg:pt-10">
        <div class="flex flex-wrap items-end justify-between gap-3">
            <div><p class="text-xs font-extrabold uppercase tracking-[.16em] text-emerald-600">Accompagnement</p><h1 class="mt-1 text-2xl font-black sm:text-3xl">Trouver mon coach</h1></div>
            {% if currentRequest %}<a href="{{ path('app_coach_status') }}" class="rounded-full bg-white px-4 py-2 text-xs font-extrabold text-emerald-700 shadow-sm ring-1 ring-slate-200">{{ currentRequest.status.value == 'approved' ? 'Mon coach' : 'Suivre ma demande' }}</a>{% endif %}
        </div>

        {% for type, messages in app.flashes %}{% for message in messages %}<div class="mt-4 rounded-xl px-4 py-3 text-sm font-bold {{ type == 'error' ? 'bg-rose-50 text-rose-700' : 'bg-emerald-50 text-emerald-700' }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}

        <form method="get" class="mt-6 grid gap-3 sm:grid-cols-[1fr_auto]" role="search">
            <label class="relative block"><span class="sr-only">Rechercher un coach</span><svg class="absolute left-4 top-1/2 size-5 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input name="q" value="{{ search }}" placeholder="Trouver un coach ou une spécialité…" class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm shadow-sm outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100"></label>
            <button class="rounded-xl bg-emerald-500 px-5 py-3 text-sm font-extrabold text-white hover:bg-emerald-600">Rechercher</button>
            <div class="flex flex-wrap gap-2 sm:col-span-2">
                <a href="{{ path('app_coach_index', search ? {q: search} : {}) }}" class="rounded-full px-4 py-2 text-xs font-bold {{ selectedSpecialty == '' ? 'bg-emerald-500 text-white' : 'bg-white text-slate-600 ring-1 ring-slate-200' }}">Toutes les spécialités</a>
                {% for specialty in specialties %}<a href="{{ path('app_coach_index', {specialty: specialty, q: search}) }}" class="rounded-full px-4 py-2 text-xs font-bold {{ selectedSpecialty|lower == specialty|lower ? 'bg-emerald-500 text-white' : 'bg-white text-slate-600 ring-1 ring-slate-200' }}">{{ specialty }}</a>{% endfor %}
            </div>
        </form>

        <section class="mt-6 grid gap-4 md:grid-cols-2" aria-label="Coachs disponibles">
            {% for coach in coaches %}
                <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                    <div class="flex gap-4"><div class="size-16 shrink-0 overflow-hidden rounded-xl">{% include 'coach/_avatar.html.twig' %}</div><div class="min-w-0"><h2 class="truncate text-base font-black">{{ coach.user.name }}</h2><div class="mt-2 flex flex-wrap gap-1">{% for tag in (coach.specialties ?? '')|split(',') %}{% if tag|trim %}<span class="rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-bold text-emerald-700">{{ tag|trim }}</span>{% endif %}{% endfor %}</div></div></div>
                    <p class="mt-4 line-clamp-2 min-h-10 text-sm italic leading-5 text-slate-600">« {{ coach.bio ?: 'Je vous accompagne vers vos objectifs avec un suivi personnalisé.' }} »</p>
                    <div class="mt-4 grid grid-cols-2 gap-2"><a href="{{ path('app_coach_show', {id: coach.id}) }}" class="rounded-lg bg-emerald-500 px-3 py-2.5 text-center text-xs font-extrabold text-white hover:bg-emerald-600">Voir le profil</a>{% include 'coach/_contact_dialog.html.twig' with {buttonClass: 'w-full rounded-lg border border-slate-400 px-3 py-2.5 text-center text-xs font-bold hover:bg-slate-50'} %}</div>
                </article>
            {% else %}
                <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center md:col-span-2"><p class="font-bold">Aucun coach ne correspond à votre recherche.</p><a href="{{ path('app_coach_index') }}" class="mt-3 inline-block text-sm font-bold text-emerald-700">Effacer les filtres</a></div>
            {% endfor %}
        </section>
    </main>
    {% include 'components/_app_navigation.html.twig' with {active: 'profile'} %}
</div>
{% endblock %}
