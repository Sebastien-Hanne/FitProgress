{% extends 'base.html.twig' %}
{% block title %}Mes séances | FitProgress{% endblock %}
{% block body %}
<div class="fit-page min-h-screen font-sans text-[#1A2B48]">{% include 'components/_app_header.html.twig' %}<main class="mx-auto max-w-3xl px-4 pb-28 pt-7"><p class="text-xs font-extrabold uppercase tracking-[.16em] text-emerald-600">Mon accompagnement</p><h1 class="mt-1 text-2xl font-black">Mes séances</h1><section class="mt-6 grid gap-3" aria-label="Mes séances de coaching">
{% for session in sessions %}{% set statusLabel = session.status.value == 'scheduled' ? 'À venir' : (session.status.value == 'completed' ? 'Terminée' : 'Annulée') %}{% set statusClass = session.status.value == 'scheduled' ? 'bg-blue-50 text-blue-700' : (session.status.value == 'completed' ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700') %}<article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm {{ session.status.value == 'cancelled' ? 'opacity-70' : '' }}"><div class="flex items-start justify-between gap-4"><div><h2 class="font-black">{{ session.title }}</h2><p class="mt-1 text-xs text-slate-500">Avec {{ session.coachProfile.user.name }}</p></div><span class="rounded-full px-2.5 py-1 text-[10px] font-bold {{ statusClass }}">{{ statusLabel }}</span></div><div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-600"><time datetime="{{ session.startAt|date('c') }}">◷ {{ session.startAt|date('d/m/Y à H:i') }}</time><span>{{ session.durationMinutes }} min</span>{% if session.location %}<span>⌖ {{ session.location }}</span>{% endif %}</div>{% if session.notes %}<p class="mt-3 rounded-xl bg-slate-50 p-3 text-xs text-slate-600">{{ session.notes }}</p>{% endif %}</article>{% else %}<p class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500">Aucune séance pour le moment.</p>{% endfor %}
</section></main>{% include 'components/_app_navigation.html.twig' with {active:'dashboard'} %}</div>
{% endblock %}
