{% extends 'base.html.twig' %}
{% block title %}Conversation | FitProgress{% endblock %}
{% block body %}{% set other = conversation.user == viewer ? conversation.coachProfile.user : conversation.user %}<div class="fit-page min-h-screen font-sans text-[#1A2B48]"><header class="sticky top-0 z-20 border-b border-slate-200 bg-white"><div class="mx-auto flex max-w-3xl items-center gap-3 px-4 py-3"><a href="{{ path('app_messages_index') }}" class="flex size-9 items-center justify-center rounded-full hover:bg-slate-100" aria-label="Retour">←</a><span class="flex size-10 items-center justify-center overflow-hidden rounded-full bg-emerald-100 text-xs font-black text-emerald-800">{% if other.photo %}<img src="{{ asset(other.photo) }}" alt="Photo de {{ other.name }}" class="size-full object-cover">{% else %}{{ other.name|split(' ')|map(part => part|first|upper)|join|slice(0, 2) }}{% endif %}</span><div class="min-w-0"><h1 class="truncate text-sm font-black">{{ other.name }}</h1><p class="truncate text-[10px] text-emerald-700">{{ other.proxyEmail }} · FitProgress privé</p></div></div></header>
<main class="mx-auto max-w-3xl px-4 pb-44 pt-5"><div class="mb-5 text-center"><span class="rounded-full bg-[#e7f0ff] px-4 py-1.5 text-[10px] font-extrabold text-emerald-700">Aujourd’hui</span></div>{% for message in conversation.messages %}{% set mine = message.sender == viewer %}<article class="mb-5 flex {{ mine ? 'justify-end' : 'justify-start' }}"><div class="max-w-[82%]"><p class="rounded-2xl px-4 py-3 text-sm leading-5 {{ mine ? 'rounded-br-sm bg-emerald-700 text-white' : 'rounded-bl-sm bg-[#dce9ff] text-[#1A2B48]' }}">{{ message.content|nl2br }}</p><p class="mt-1 text-[9px] text-emerald-700 {{ mine ? 'text-right' : '' }}">{{ message.sentAt|date('H:i') }}{% if mine %} {{ message.read ? '✓✓' : '✓' }}{% endif %}</p></div></article>{% else %}<p class="py-20 text-center text-sm text-slate-400">Commencez la conversation avec {{ other.name }}.</p>{% endfor %}</main>
<div class="fixed inset-x-0 bottom-[4.5rem] z-20 border-t border-slate-200 bg-white px-3 py-3"><form method="post" action="{{ path('app_messages_send', {id: conversation.id}) }}" class="mx-auto flex max-w-3xl items-end gap-2"><input type="hidden" name="_token" value="{{ csrf_token('send_message_' ~ conversation.id) }}"><label class="sr-only" for="message-content">Écrire un message</label><textarea id="message-content" name="content" maxlength="1000" rows="1" required placeholder="Écrire un message…" class="max-h-28 min-h-11 flex-1 resize-none rounded-3xl border border-slate-300 bg-slate-50 px-5 py-3 text-sm outline-none focus:border-emerald-500"></textarea><button class="flex size-11 shrink-0 items-center justify-center rounded-full bg-emerald-700 text-xl text-white" aria-label="Envoyer">➤</button></form>{% for message in app.flashes('error') %}<p class="mx-auto mt-1 max-w-3xl text-xs text-rose-600">{{ message }}</p>{% endfor %}</div>{% if is_granted('ROLE_COACH') %}{% include 'components/_coach_navigation.html.twig' with {active: 'messages'} %}{% else %}{% include 'components/_app_navigation.html.twig' with {active: 'profile'} %}{% endif %}</div>{% endblock %}
