{% extends 'base.html.twig' %}
{% block title %}Messagerie | FitProgress{% endblock %}
{% block body %}<div class="fit-page min-h-screen font-sans text-[#1A2B48]">{% include 'components/_app_header.html.twig' %}<main class="mx-auto max-w-3xl px-4 pb-28 pt-7 sm:px-6"><div class="flex items-end justify-between"><div><p class="text-xs font-extrabold uppercase tracking-[.16em] text-emerald-600">Échanges privés</p><h1 class="mt-1 text-2xl font-black">Messages</h1></div><span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">{{ unread_message_count() }} non lu{{ unread_message_count() != 1 ? 's' }}</span></div>
<section class="mt-6 grid gap-3" aria-label="Liste des conversations">{% for conversation in conversations %}{% set other = conversation.user == app.user ? conversation.coachProfile.user : conversation.user %}{% set lastMessage = conversation.messages|last %}{% set unread = conversation.messages|filter(message => message.sender != app.user and not message.read)|length %}<a href="{{ path('app_messages_show', {id: conversation.id}) }}" class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-emerald-300"><span class="flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-emerald-100 font-black text-emerald-800">{% if other.photo %}<img src="{{ asset(other.photo) }}" alt="Photo de {{ other.name }}" class="size-full object-cover">{% else %}{{ other.name|split(' ')|map(part => part|first|upper)|join|slice(0, 2) }}{% endif %}</span><span class="min-w-0 flex-1"><span class="flex items-center justify-between gap-3"><strong class="truncate text-sm">{{ other.name }}</strong><small class="shrink-0 text-[10px] text-slate-400">{{ (conversation.lastMessageAt ?? conversation.createdAt)|date('d/m H:i') }}</small></span><span class="mt-1 block truncate text-xs text-slate-500">{{ lastMessage ? lastMessage.content : 'Conversation ouverte — écrivez votre premier message.' }}</span><span class="mt-1 block text-[9px] text-slate-400">via {{ other.proxyEmail }}</span></span>{% if unread %}<span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-[10px] font-black text-white">{{ unread }}</span>{% endif %}</a>{% else %}<div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center"><p class="font-black">Aucune conversation</p><p class="mt-2 text-sm text-slate-500">La messagerie s’ouvre dès qu’un coach accepte une demande d’accompagnement.</p>{% if not is_granted('ROLE_COACH') %}<a href="{{ path('app_coach_index') }}" class="mt-5 inline-block rounded-xl bg-emerald-500 px-5 py-3 text-sm font-bold text-white">Trouver un coach</a>{% endif %}</div>{% endfor %}</section></main>{% if is_granted('ROLE_COACH') %}{% include 'components/_coach_navigation.html.twig' with {active:'messages'} %}{% else %}{% include 'components/_app_navigation.html.twig' with {active:'profile'} %}{% endif %}</div>{% endblock %}
