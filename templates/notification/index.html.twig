{% extends 'base.html.twig' %}
{% block title %}Notifications | FitProgress{% endblock %}
{% block body %}
{% set today = 'now'|date('Y-m-d') %}{% set yesterday = 'yesterday'|date('Y-m-d') %}
<div class="fit-page min-h-screen font-sans text-[#1A2B48]">{% include 'components/_app_header.html.twig' %}
<main class="mx-auto max-w-3xl px-4 pb-28 pt-6 sm:px-6">
<div class="flex items-center justify-between gap-4"><div><p class="text-xs font-extrabold uppercase tracking-[.16em] text-emerald-600">Votre activité</p><h1 class="mt-1 text-2xl font-black">Notifications</h1></div>{% if notifications|filter(item => not item.read)|length %}<form method="post" action="{{ path('app_notifications_read_all') }}"><input type="hidden" name="_token" value="{{ csrf_token('notifications-read-all') }}"><button class="rounded-xl bg-emerald-500 px-4 py-2.5 text-xs font-bold text-white">Tout marquer comme lu</button></form>{% endif %}</div>

{% set currentGroup = '' %}<div class="mt-6">
{% for notification in notifications %}
    {% set notificationDay = notification.createdAt|date('Y-m-d') %}{% set group = notificationDay == today ? "Aujourd'hui" : (notificationDay == yesterday ? 'Hier' : notification.createdAt|date('d F Y')) %}
    {% if group != currentGroup %}{% if not loop.first %}</section>{% endif %}<h2 class="mb-3 mt-6 text-sm font-bold text-slate-500">{{ group }}</h2><section class="grid gap-3" aria-label="Notifications du {{ group }}">{% set currentGroup = group %}{% endif %}
    {% set icon = notification.type.value in ['new_message'] ? '✉' : (notification.type.value in ['new_coach_request', 'request_accepted', 'request_rejected'] ? '♟' : (notification.type.value starts with 'session_' ? '▣' : '✓')) %}
    {% set iconClass = notification.type.value == 'request_rejected' or notification.type.value == 'session_cancelled' ? 'bg-rose-100 text-rose-700' : (notification.type.value starts with 'session_' ? 'bg-blue-100 text-blue-700' : 'bg-emerald-500 text-white') %}
    {% set opensContent = notification.type.value in ['new_message', 'new_feedback', 'new_coach_request', 'request_accepted'] %}
    <article class="relative flex items-center gap-3 rounded-xl border bg-white p-4 shadow-sm transition {{ notification.read ? 'border-slate-200' : 'border-emerald-300 ring-1 ring-emerald-100' }} {{ opensContent ? 'hover:border-emerald-400 hover:shadow-md' : '' }}">
    {% if opensContent %}<a href="{{ path('app_notifications_open', {id: notification.id}) }}" class="flex min-w-0 flex-1 items-center gap-4 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500" aria-label="Ouvrir : {{ notification.title }}">{% else %}<div class="flex min-w-0 flex-1 items-center gap-4">{% endif %}
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full text-lg {{ iconClass }}" aria-hidden="true">{{ icon }}</span>
        <div class="min-w-0 flex-1"><div class="flex items-start justify-between gap-3"><h3 class="text-sm font-black">{{ notification.title }}</h3><time class="shrink-0 text-[9px] text-slate-400" datetime="{{ notification.createdAt|date('c') }}">{{ notificationDay in [today, yesterday] ? notification.createdAt|date('H:i') : notification.createdAt|date('d/m') }}</time></div><p class="mt-1 text-sm leading-5 text-slate-600">{{ notification.content }}</p>{% if not notification.read and not opensContent %}<form method="post" action="{{ path('app_notifications_read', {id: notification.id}) }}" class="mt-2"><input type="hidden" name="_token" value="{{ csrf_token('notification-read-' ~ notification.id) }}"><button class="text-[10px] font-bold text-emerald-700">Marquer comme lue</button></form>{% endif %}</div>
    {% if opensContent %}</a>{% else %}</div>{% endif %}
    <form method="post" action="{{ path('app_notifications_delete', {id: notification.id}) }}" class="shrink-0" onsubmit="return confirm('Supprimer cette notification ?')">
        <input type="hidden" name="_token" value="{{ csrf_token('notification-delete-' ~ notification.id) }}">
        <button type="submit" class="flex size-8 items-center justify-center rounded-full text-slate-400 transition hover:bg-rose-50 hover:text-rose-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500" aria-label="Supprimer la notification : {{ notification.title }}" title="Supprimer">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 13H7L6 7"/></svg>
            <span class="sr-only">Supprimer la notification : {{ notification.title }}</span>
        </button>
    </form>
    {% if not notification.read %}<span class="absolute right-3 top-2 size-2 rounded-full bg-emerald-500" aria-label="Non lue"></span>{% endif %}
    </article>
    {% if loop.last %}</section>{% endif %}
{% else %}<div class="py-24 text-center"><span class="text-5xl text-slate-300">✓✓</span><h2 class="mt-5 font-black">Vous êtes à jour !</h2><p class="mt-2 text-sm text-slate-500">Aucune notification pour le moment.</p></div>{% endfor %}
</div></main>{% if is_granted('ROLE_COACH') and not is_granted('ROLE_ADMIN') %}{% include 'components/_coach_navigation.html.twig' with {active: ''} %}{% else %}{% include 'components/_app_navigation.html.twig' with {active: 'profile'} %}{% endif %}</div>
{% endblock %}
