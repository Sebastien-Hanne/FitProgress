{% extends 'base.html.twig' %}

{% block title %}Connexion | FitProgress{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#8E8E93] flex items-center justify-center p-4 py-8 font-sans">
    <div class="max-w-md w-full bg-white rounded-[2.5rem] shadow-2xl overflow-hidden">

        {# --- IMAGE D'EN-TÊTE (Logo) --- #}
        <div class="w-full h-56 bg-white flex items-center justify-center p-8">
            <img src="{{ asset('img/logo.png') }}" alt="Logo FitProgress" class="max-h-full w-auto object-contain">
        </div>

        <div class="p-6 space-y-5">

            {# Messages Flash #}
            {% for message in app.flashes('success') %}
                <div class="p-3 text-xs font-semibold text-emerald-800 bg-emerald-100/80 rounded-2xl border border-emerald-200">
                    {{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="p-3 text-xs font-semibold text-red-800 bg-red-100/80 rounded-2xl border border-red-200">
                    {{ message }}
                </div>
            {% endfor %}

            {# Erreur d'authentification Symfony #}
            {% if error %}
                <div class="p-3 text-xs font-semibold text-red-800 bg-red-100/80 rounded-2xl border border-red-200">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="text-center text-xs text-slate-500">
                    Vous êtes connecté en tant que {{ app.user.userIdentifier }},
                    <a href="{{ path('app_logout') }}" class="text-emerald-600 font-bold hover:underline">Déconnexion</a>
                </div>
            {% else %}

                {# --- FORMULAIRE --- #}
                <form method="post" class="space-y-4">

                    {# --- EMAIL --- #}
                    <div>
                        <label for="inputEmail" class="block text-xs font-bold text-[#1a2b48] mb-1.5">Email</label>
                        <div class="relative">
                            <input type="email" value="{{ last_username }}" name="email" id="inputEmail"
                                class="w-full pl-4 pr-11 py-3.5 bg-slate-50 border border-slate-200 rounded-2xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-400 transition-all"
                                autocomplete="email" required autofocus placeholder="nom@exemple.com">
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-slate-400">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                            </div>
                        </div>
                    </div>

                    {# --- MOT DE PASSE --- #}
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label for="inputPassword" class="text-xs font-bold text-[#1a2b48]">Mot de passe</label>
                            <a href="{{path('app_forgot_password_request')}}" class="text-xs font-bold text-[#1a2b48] hover:text-emerald-600 transition-colors">
                                Mot de passe oublié ?
                            </a>
                        </div>
                        <div class="relative">
                            <input type="password" name="password" id="inputPassword"
                                class="w-full pl-4 pr-11 py-3.5 bg-slate-50 border border-slate-200 rounded-2xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-400 transition-all"
                                autocomplete="current-password" required placeholder="••••••••">
                            <button type="button" onclick="togglePasswordVisibility('inputPassword', this)"
                                    class="absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-emerald-600 focus:outline-none transition-colors">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    {# Jeton CSRF #}
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    {# --- BOUTON VERT --- #}
                    <button type="submit"
                        class="w-full bg-[#16A34A] hover:bg-[#15803D] active:scale-[0.99] text-white font-bold py-4 px-4 rounded-full shadow-lg shadow-green-600/20 transition-all flex items-center justify-center gap-2 text-sm cursor-pointer mt-2">
                        <span>Se connecter</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </button>
                </form>

                {# --- BANDEAU STATISTIQUE BLEU --- #}
                <div class="bg-[#3B5BFE] rounded-2xl p-4 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-[#0B1120] flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                        </svg>
                    </div>
                    <p class="text-white text-xs leading-snug">
                        <span class="font-bold">84%</span> parmi les utilisateurs de FitProgress
                        atteignent leurs objectifs en moins de trois mois.
                    </p>
                </div>

                {# --- BARRE INSCRIPTION --- #}
                <div class="bg-white border border-slate-100 rounded-2xl p-4 flex items-center justify-between shadow-sm">
                    <span class="text-sm font-bold text-[#1a2b48]">Pas encore inscrit ?</span>
                    <a href="{{ path('app_register') }}"
                       class="flex items-center gap-1.5 text-sm font-bold text-[#1a2b48] hover:text-emerald-600 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM19 8v6M22 11h-6"/>
                        </svg>
                        S'inscrire
                    </a>
                </div>

            {% endif %}

        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        if (!input) return;
        if (input.type === 'password') {
            input.type = 'text';
            btn.classList.add('text-emerald-600');
            btn.classList.remove('text-slate-400');
        } else {
            input.type = 'password';
            btn.classList.remove('text-emerald-600');
            btn.classList.add('text-slate-400');
        }
    }
</script>
{% endblock %}
